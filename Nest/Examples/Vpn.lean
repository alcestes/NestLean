/-- Deep adequacy of `ClientA` with empty seen set. -/
theorem ClientA_deep : Prunable [] ClientA := by
  apply Prunable.extC [] "Auth" _ _ hfaClientA
  intro x hmem
  simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem
  obtain ⟨rfl, rfl, rfl⟩ := hmem
  apply Prunable.trec_new [] "tryAuth" VATB _ _ hfaVATRec
  · simp
  · have hSub : substSessionType VATB "tryAuth"
        (SessionType.tRec "tryAuth" VATB) = VATS := VATS_subst
    rw [hSub]
    apply Prunable.intC [VATRec] _ _ hfaVATS
    intro y hmemY
    simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmemY
    obtain ⟨rfl, rfl, rfl, rfl⟩ := hmemY
    apply Prunable.extC [VATRec] "Auth" _ _ hfaVATES
    intro z hmemZ
    simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmemZ
    rcases hmemZ with ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩
    · exact Prunable.trec_seen [VATRec] "tryAuth" VATB
        (List.mem_cons.mpr (Or.inl rfl)) hfaVATRec
    · apply Prunable.trec_new [VATRec] "requestB" VAQB _ _ hfaVARB
      · intro hcon
        simp only [List.mem_cons, List.mem_nil_iff, or_false] at hcon
        injection hcon with hX _
        exact absurd hX (by decide)
      · have hSub2 : substSessionType VAQB "requestB"
            (SessionType.tRec "requestB" VAQB) = VAQBS := VAQBS_subst
        rw [hSub2]
        apply Prunable.intC [VARB, VATRec] _ _ hfaVAQBS
        intro w hmemW
        simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmemW
        rcases hmemW with ⟨rfl, rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl, rfl⟩
        · apply Prunable.extC [VARB, VATRec] "C_B" _ _ hfaVAQRS
          intro v hmemV
          simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmemV
          obtain ⟨rfl, rfl, rfl⟩ := hmemV
          exact Prunable.trec_seen [VARB, VATRec] "requestB" VAQB
            (List.mem_cons.mpr (Or.inl rfl)) hfaVARB
        · apply Prunable.trec_new [VARB, VATRec] "requestC" VAQC _ _ hfaVARC
          · intro hcon
            simp only [List.mem_cons, List.mem_nil_iff, or_false] at hcon
            rcases hcon with hEq | hEq
            · injection hEq with hX _
              exact absurd hX (by decide)
            · injection hEq with hX _
              exact absurd hX (by decide)
          · have hSub3 : substSessionType VAQC "requestC"
                (SessionType.tRec "requestC" VAQC) = VAQCS := VAQCS_subst
            rw [hSub3]
            apply Prunable.intC [VARC, VARB, VATRec] _ _ hfaVAQCS
            intro u hmemU
            simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmemU
            rcases hmemU with ⟨rfl, rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl, rfl⟩
            · apply Prunable.extC [VARC, VARB, VATRec] "C_C" _ _ hfaVAQCRS
              intro t hmemT
              simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmemT
              obtain ⟨rfl, rfl, rfl⟩ := hmemT
              exact Prunable.trec_seen [VARC, VARB, VATRec] "requestC" VAQC
                (List.mem_cons.mpr (Or.inl rfl)) hfaVARC
            · apply Prunable.intC [VARC, VARB, VATRec] _ _ hfaVAQT
              intro t hmemT
              simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmemT
              obtain ⟨rfl, rfl, rfl, rfl⟩ := hmemT
              exact Prunable.tEnd [VARC, VARB, VATRec]

