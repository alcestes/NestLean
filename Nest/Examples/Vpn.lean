/- Session types from the NEST P4 testbed:
   `NEST/nest/nest_scala/src/main/scala/examples/03_vpn.scala`
   (Scala package `vpn`; file `03_vpn.scala` maps to this module since
   Lean module names may not start with a digit).
   Translated below are the four `lst_*` local session types
   (`lst_Auth`, `lst_ClientA`, `lst_ClientB`, `lst_ClientC`) plus the
   `questionable` type built in `debug()` (kept under that name).
   Switch setup, IP rules, port checks, monitor wiring and the trailing
   status comment are not session types and are not translated.
   Translation conventions: `IntChoice` branches become
   `internalChoice` branches `(agent, label, sort, cont)`; `ExtChoice`
   branches become `externalChoice` branches `(label, sort, cont)`;
   `Rec`/`Var`/`End` become `tRec`/`tVar`/`tEnd`. Agents become roles,
   labels stay labels. The Scala types carry no payload sorts, so every
   branch uses the placeholder sort `"unit"`. -/

/-- `lst_Auth`. -/
def Auth : SessionType :=
  SessionType.internalChoice
    [("C_A", "Init", "unit",
      SessionType.internalChoice
        [("C_B", "Init", "unit",
          SessionType.internalChoice
            [("C_C", "Init", "unit",
              SessionType.tRec "acceptOrDeny"
                (SessionType.externalChoice "C_A"
                  [("GetAuth", "unit",
                    SessionType.externalChoice "C_B"
                      [("GetAuth", "unit",
                        SessionType.externalChoice "C_C"
                          [("GetAuth", "unit",
                            SessionType.internalChoice
                              [("C_A", "Acc", "unit",
                                SessionType.internalChoice
                                  [("C_B", "Acc", "unit",
                                    SessionType.internalChoice
                                      [("C_C", "Acc", "unit",
                                        SessionType.externalChoice "C_A"
                                          [("Term", "unit",
                                            SessionType.tEnd)])])]),
                               ("C_A", "Deny", "unit",
                                SessionType.internalChoice
                                  [("C_B", "Deny", "unit",
                                    SessionType.internalChoice
                                      [("C_C", "Deny", "unit",
                                        SessionType.tVar "acceptOrDeny")])])])])])]))])])]

/-- `lst_ClientA`. -/
def ClientA : SessionType :=
  SessionType.externalChoice "Auth"
    [("Init", "unit",
      SessionType.tRec "tryAuth"
        (SessionType.internalChoice
          [("Auth", "GetAuth", "unit",
            SessionType.externalChoice "Auth"
              [("Deny", "unit", SessionType.tVar "tryAuth"),
               ("Acc", "unit",
                SessionType.tRec "requestB"
                  (SessionType.internalChoice
                    [("C_B", "Rqs", "unit",
                      SessionType.externalChoice "C_B"
                        [("Rsp", "unit", SessionType.tVar "requestB")]),
                     ("C_B", "Term", "unit",
                      SessionType.tRec "requestC"
                        (SessionType.internalChoice
                          [("C_C", "Rqs", "unit",
                            SessionType.externalChoice "C_C"
                              [("Rsp", "unit",
                                SessionType.tVar "requestC")]),
                           ("C_C", "Term", "unit",
                            SessionType.internalChoice
                              [("Auth", "Term", "unit",
                                SessionType.tEnd)])]))]))])]))]

/-- `lst_ClientB`. -/
def ClientB : SessionType :=
  SessionType.externalChoice "Auth"
    [("Init", "unit",
      SessionType.tRec "tryAuth"
        (SessionType.internalChoice
          [("Auth", "GetAuth", "unit",
            SessionType.externalChoice "Auth"
              [("Deny", "unit", SessionType.tVar "tryAuth"),
               ("Acc", "unit",
                SessionType.tRec "responseA"
                  (SessionType.externalChoice "C_A"
                    [("Rqs", "unit",
                      SessionType.internalChoice
                        [("C_A", "Rsp", "unit",
                          SessionType.tVar "responseA")]),
                     ("Term", "unit",
                      SessionType.tEnd)]))])]))]

/-- `lst_ClientC` (same shape as `lst_ClientB`, separate type). -/
def ClientC : SessionType :=
  SessionType.externalChoice "Auth"
    [("Init", "unit",
      SessionType.tRec "tryAuth"
        (SessionType.internalChoice
          [("Auth", "GetAuth", "unit",
            SessionType.externalChoice "Auth"
              [("Deny", "unit", SessionType.tVar "tryAuth"),
               ("Acc", "unit",
                SessionType.tRec "responseA"
                  (SessionType.externalChoice "C_A"
                    [("Rqs", "unit",
                      SessionType.internalChoice
                        [("C_A", "Rsp", "unit",
                          SessionType.tVar "responseA")]),
                     ("Term", "unit",
                      SessionType.tEnd)]))])]))]


-- Mirror defs for `Auth` (ungrafted; loop keeps the var)
/-- External offer by `C_A`: `(Term, unit)` ending in `tEnd` (`Auth` mirror). -/
def AT : SessionType :=
  SessionType.externalChoice "C_A" [("Term", "unit", SessionType.tEnd)]
/-- Internal choice: `(C_C, Acc, unit)` continuing as `AT` (`Auth` mirror). -/
def AAA : SessionType :=
  SessionType.internalChoice [("C_C", "Acc", "unit", AT)]
/-- Internal choice: `(C_B, Acc, unit)` continuing as `AAA` (`Auth` mirror). -/
def AA : SessionType :=
  SessionType.internalChoice [("C_B", "Acc", "unit", AAA)]
/-- Internal choice: `(C_C, Deny, unit)` looping on `acceptOrDeny` (`Auth` mirror). -/
def ADnn : SessionType :=
  SessionType.internalChoice
    [("C_C", "Deny", "unit", SessionType.tVar "acceptOrDeny")]
/-- Internal choice: `(C_B, Deny, unit)` continuing as `ADnn` (`Auth` mirror). -/
def ADn : SessionType :=
  SessionType.internalChoice [("C_B", "Deny", "unit", ADnn)]
/-- Internal choice: `(C_A, Acc, unit)` continuing as `AA`; `(C_A, Deny, unit)` continuing as
   `ADn` (`Auth` mirror). -/
def AD : SessionType :=
  SessionType.internalChoice
    [("C_A", "Acc", "unit", AA),
     ("C_A", "Deny", "unit", ADn)]
/-- External offer by `C_C`: `(GetAuth, unit)` continuing as `AD` (`Auth` mirror). -/
def AC : SessionType :=
  SessionType.externalChoice "C_C" [("GetAuth", "unit", AD)]
/-- External offer by `C_B`: `(GetAuth, unit)` continuing as `AC` (`Auth` mirror). -/
def AB : SessionType :=
  SessionType.externalChoice "C_B" [("GetAuth", "unit", AC)]
/-- External offer by `C_A`: `(GetAuth, unit)` continuing as `AB` (`Auth` mirror). -/
def ABody : SessionType :=
  SessionType.externalChoice "C_A" [("GetAuth", "unit", AB)]
/-- Recursive type: loop on `acceptOrDeny` with body `ABody` (`Auth` mirror). -/
def ARec := SessionType.tRec "acceptOrDeny" ABody
/-- Internal choice: `(C_C, Init, unit)` continuing as `ARec` (`Auth` mirror). -/
def AV2 : SessionType :=
  SessionType.internalChoice [("C_C", "Init", "unit", ARec)]
/-- Internal choice: `(C_B, Init, unit)` continuing as `AV2` (`Auth` mirror). -/
def AV1 : SessionType :=
  SessionType.internalChoice [("C_B", "Init", "unit", AV2)]
-- Grafted side (loop points at the rec)
/-- Internal choice: `(C_C, Deny, unit)` continuing as `ARec` (`Auth` mirror). -/
def ADnnS : SessionType :=
  SessionType.internalChoice [("C_C", "Deny", "unit", ARec)]
/-- Internal choice: `(C_B, Deny, unit)` continuing as `ADnnS` (`Auth` mirror). -/
def ADnS : SessionType :=
  SessionType.internalChoice [("C_B", "Deny", "unit", ADnnS)]
/-- Internal choice: `(C_A, Acc, unit)` continuing as `AA`; `(C_A, Deny, unit)` continuing as
   `ADnS` (`Auth` mirror). -/
def ADS : SessionType :=
  SessionType.internalChoice
    [("C_A", "Acc", "unit", AA),
     ("C_A", "Deny", "unit", ADnS)]
/-- External offer by `C_C`: `(GetAuth, unit)` continuing as `ADS` (`Auth` mirror). -/
def ACS : SessionType :=
  SessionType.externalChoice "C_C" [("GetAuth", "unit", ADS)]
/-- External offer by `C_B`: `(GetAuth, unit)` continuing as `ACS` (`Auth` mirror). -/
def ABS : SessionType :=
  SessionType.externalChoice "C_B" [("GetAuth", "unit", ACS)]
/-- External offer by `C_A`: `(GetAuth, unit)` continuing as `ABS` (`Auth` mirror). -/
def ASub : SessionType :=
  SessionType.externalChoice "C_A" [("GetAuth", "unit", ABS)]

/-- Grafting equation: substituting `ARec` for `acceptOrDeny` in `ABody` yields `ASub`. -/
theorem ASub_subst :
    substSessionType ABody "acceptOrDeny" ARec = ASub := rfl

