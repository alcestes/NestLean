-- Mirror defs for `ClientB` (ungrafted; vars kept)
/-- Internal choice: `(C_A, Rsp, unit)` looping on `responseA` (`ClientB` mirror). -/
def BRR : SessionType :=
  SessionType.internalChoice
    [("C_A", "Rsp", "unit", SessionType.tVar "responseA")]
/-- External offer by `C_A`: `(Rqs, unit)` continuing as `BRR`; `(Term, unit)` ending in `tEnd`
   (`ClientB` mirror). -/
def BRBody : SessionType :=
  SessionType.externalChoice "C_A"
    [("Rqs", "unit", BRR),
     ("Term", "unit", SessionType.tEnd)]
/-- Recursive type: loop on `responseA` with body `BRBody` (`ClientB` mirror). -/
def BRRec := SessionType.tRec "responseA" BRBody
/-- External offer by `Auth`: `(Deny, unit)` looping on `tryAuth`; `(Acc, unit)` continuing as
   `BRRec` (`ClientB` mirror). -/
def BTE : SessionType :=
  SessionType.externalChoice "Auth"
    [("Deny", "unit", SessionType.tVar "tryAuth"),
     ("Acc", "unit", BRRec)]
/-- Internal choice: `(Auth, GetAuth, unit)` continuing as `BTE` (`ClientB` mirror). -/
def BTBody : SessionType :=
  SessionType.internalChoice [("Auth", "GetAuth", "unit", BTE)]
/-- Recursive type: loop on `tryAuth` with body `BTBody` (`ClientB` mirror). -/
def BTRec := SessionType.tRec "tryAuth" BTBody
-- Grafted trys (tryAuth-vars point at the tryAuth rec)
/-- Internal choice: `(C_A, Rsp, unit)` continuing as `BRRec` (`ClientB` mirror). -/
def BRRg : SessionType :=
  SessionType.internalChoice [("C_A", "Rsp", "unit", BRRec)]
/-- External offer by `C_A`: `(Rqs, unit)` continuing as `BRRg`; `(Term, unit)` ending in `tEnd`
   (`ClientB` mirror). -/
def BRSub : SessionType :=
  SessionType.externalChoice "C_A"
    [("Rqs", "unit", BRRg),
     ("Term", "unit", SessionType.tEnd)]
/-- External offer by `Auth`: `(Deny, unit)` continuing as `BTRec`; `(Acc, unit)` continuing as
   `BRRec` (`ClientB` mirror). -/
def BTEg : SessionType :=
  SessionType.externalChoice "Auth"
    [("Deny", "unit", BTRec),
     ("Acc", "unit", BRRec)]
/-- Internal choice: `(Auth, GetAuth, unit)` continuing as `BTEg` (`ClientB` mirror). -/
def BTSub : SessionType :=
  SessionType.internalChoice [("Auth", "GetAuth", "unit", BTEg)]

/-- Grafting equation: substituting `BTRec` for `tryAuth` in `BTBody` yields `BTSub`. -/
theorem BTSub_subst :
    substSessionType BTBody "tryAuth" BTRec = BTSub := rfl
/-- Grafting equation: substituting `BRRec` for `responseA` in `BRBody` yields `BRSub`. -/
theorem BRSub_subst :
    substSessionType BRBody "responseA" BRRec = BRSub := rfl

-- `Has` facts for the witness (by decide)
/-- The prune `Has` check for (`C_A`, `Rqs`, `unit`) on `BTEg` is `true` (offered by the type). -/
theorem B_has_TEg_Rqs_true :
    pruneFirstInputDeepHas "C_A" "Rqs" "unit" BTEg = true := by decide
/-- The prune `Has` check for (`C_A`, `Rqs`, `unit`) on `BTRec` is `true` (offered by the type). -/
theorem B_has_TRec_Rqs_true :
    pruneFirstInputDeepHas "C_A" "Rqs" "unit" BTRec = true := by decide

-- Negative: forced tryAuth/Deny cycle fires at (C_A, Rqs), so `BTRec`
-- is not one-message prunable there (mirrors `Kx_not_prunable_one_msg`).
/-- One-message prunability of `BTRec` for (`C_A`, `Rqs`, `unit`). -/
theorem BTRec_not_prunable_one_msg : ¬ PrunableOneMsg "C_A" "Rqs" "unit" BTRec := by
  intro hOneMsg
  have hmemG : ("Auth", "GetAuth", "unit", BTEg) ∈
      ([("Auth", "GetAuth", "unit", BTEg)] :
        List (Role × Lab × DataSort × SessionType)) :=
    List.mem_cons.mpr (Or.inl rfl)
  have hmemD : ("Deny", "unit", BTRec) ∈
      ([("Deny", "unit", BTRec), ("Acc", "unit", BRRec)] :
        List (Lab × DataSort × SessionType)) :=
    List.mem_cons.mpr (Or.inl rfl)
  have hT : forced_step "C_A" "Rqs" "unit" BTRec BTSub := forced_step.trec
  have hG : forced_step "C_A" "Rqs" "unit" BTSub BTEg :=
    forced_step.intC hmemG B_has_TEg_Rqs_true
  have hD : forced_step "C_A" "Rqs" "unit" BTEg BTRec :=
    forced_step.extCQ (by decide) hmemD B_has_TRec_Rqs_true
  have hRTC : Relation.ReflTransGen (forced_step "C_A" "Rqs" "unit") BTRec BTEg :=
    (Relation.ReflTransGen.single hT).trans (Relation.ReflTransGen.single hG)
  exact hOneMsg BTEg BTRec hRTC hD hRTC

-- Exposure reaching the inner responseA Rqs-branch
/-- Exposure: `BTRec` offers `("C_A", "Rqs", "unit")`. -/
theorem BTRec_exposed_Rqs : ExposedFrom BTRec "C_A" "Rqs" "unit" := by
  have hRqs : ("Rqs", "unit", BRR) ∈
      ([("Rqs", "unit", BRR), ("Term", "unit", SessionType.tEnd)] :
        List (Lab × DataSort × SessionType)) :=
    List.mem_cons.mpr (Or.inl rfl)
  have hHere : ExposedFrom BRBody "C_A" "Rqs" "unit" :=
    ExposedFrom.extC_here hRqs
  have hResp : ExposedFrom BRRec "C_A" "Rqs" "unit" :=
    ExposedFrom.trec hHere
  have hAcc : ("Acc", "unit", BRRec) ∈
      ([("Deny", "unit", SessionType.tVar "tryAuth"), ("Acc", "unit", BRRec)] :
        List (Lab × DataSort × SessionType)) :=
    List.mem_cons.mpr (Or.inr (List.mem_cons.mpr (Or.inl rfl)))
  have hneA : ("Auth" : Role) ≠ "C_A" := by decide
  have hTE : ExposedFrom BTE "C_A" "Rqs" "unit" :=
    ExposedFrom.extC_step (x := ("Acc", "unit", BRRec)) hneA hAcc hResp
  have hGet : ("Auth", "GetAuth", "unit", BTE) ∈
      ([("Auth", "GetAuth", "unit", BTE)] :
        List (Role × Lab × DataSort × SessionType)) :=
    List.mem_cons.mpr (Or.inl rfl)
  have hTB : ExposedFrom BTBody "C_A" "Rqs" "unit" :=
    ExposedFrom.intC_step hGet hneA hTE
  exact ExposedFrom.trec hTB

/-- Deep adequacy of `BTRec` with empty seen set. -/
theorem BTRec_not_deep : ¬ Prunable [] BTRec := by
  intro hPrunable
  exact BTRec_not_prunable_one_msg
    (deep_has_acyclic hPrunable "C_A" "Rqs" "unit" BTRec_exposed_Rqs)

