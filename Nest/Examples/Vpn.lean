/-- One-message prunability fact. -/
theorem hfaAuth : ∀ (pm : Role) (lab0 : Lab) (S0 : DataSort),
    ExposedFrom Auth pm lab0 S0 → PrunableOneMsg pm lab0 S0 Auth := by
  intro pm lab0 S0 hexp
