-- FA facts about the grafted body (named; nested of_step, no cycles)
/-- One-message prunability of `ASub` for (`C_B`, `GetAuth`, `unit`). -/
theorem FA_ASub_GetB : PrunableOneMsg "C_B" "GetAuth" "unit" ASub := by
  apply prunable_one_msg_extC_of_step "C_A" _ "C_B" "GetAuth" "unit"
  intro V hS
  cases hS with
  | @extCQ _ _ x _ hmem hHas =>
    obtain ⟨l, s, U⟩ := x
    simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem
    obtain ⟨rfl, rfl, rfl⟩ := hmem
    show PrunableOneMsg "C_B" "GetAuth" "unit" ABS
    apply prunable_one_msg_extC_of_step "C_B" _ "C_B" "GetAuth" "unit"
    intro W hS2
    cases hS2 with
    | @extCQ _ _ y _ hmem2 hHas2 =>
      obtain ⟨l2, s2, U2⟩ := y
      simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem2
      obtain ⟨rfl, rfl, rfl⟩ := hmem2
      show PrunableOneMsg "C_B" "GetAuth" "unit" ACS
      apply prunable_one_msg_extC_of_step "C_C" _ "C_B" "GetAuth" "unit"
      intro Z hS3
      cases hS3 with
      | @extCQ _ _ z _ hmem3 hHas3 =>
        obtain ⟨l3, s3, U3⟩ := z
        simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem3
        obtain ⟨rfl, rfl, rfl⟩ := hmem3
        have h3 : pruneFirstInputDeepHas "C_B" "GetAuth" "unit" ADS = true := hHas3
        rw [A_has_DS_GetB_false] at h3
        cases h3
