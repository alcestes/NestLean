/-- One-message prunability fact. -/
theorem hfaARec : ∀ (pm : Role) (lab0 : Lab) (S0 : DataSort),
    ExposedFrom ARec pm lab0 S0 → PrunableOneMsg pm lab0 S0 ARec := by
  intro pm lab0 S0 hexp
  cases hexp with
  | trec hsub =>
    cases hsub with
    | extC_here hmem =>
      simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem
      obtain ⟨rfl, rfl, rfl⟩ := hmem
      exact FA_ARec_GetA
    | extC_step hne hmem hsub2 =>
      simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem
      obtain ⟨rfl, rfl, rfl⟩ := hmem
      cases hsub2 with
      | extC_here hmem2 =>
        simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem2
        obtain ⟨rfl, rfl, rfl⟩ := hmem2
        exact FA_ARec_GetB
      | extC_step hne2 hmem2 hsub3 =>
        simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem2
        obtain ⟨rfl, rfl, rfl⟩ := hmem2
        cases hsub3 with
        | extC_here hmem3 =>
          simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem3
          obtain ⟨rfl, rfl, rfl⟩ := hmem3
          exact FA_ARec_GetC
        | extC_step hne3 hmem3 hsub4 =>
          simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem3
          obtain ⟨rfl, rfl, rfl⟩ := hmem3
          cases hsub4 with
          | intC_step hmem4 hne4 hsub5 =>
            simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem4
            rcases hmem4 with ⟨rfl, rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl, rfl⟩
            · cases hsub5 with
              | intC_step hmem5 hne5 hsub6 =>
                simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem5
                obtain ⟨rfl, rfl, rfl, rfl⟩ := hmem5
                cases hsub6 with
                | intC_step hmem6 hne6 hsub7 =>
                  simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem6
                  obtain ⟨rfl, rfl, rfl, rfl⟩ := hmem6
                  cases hsub7 with
                  | extC_here hmem7 =>
                    simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem7
                    obtain ⟨rfl, rfl, rfl⟩ := hmem7
                    exact FA_ARec_TermA
                  | extC_step hne7 hmem7 hsub8 =>
                    simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem7
                    obtain ⟨rfl, rfl, rfl⟩ := hmem7
                    cases hsub8
            · cases hsub5 with
              | intC_step hmem5 hne5 hsub6 =>
                simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem5
                obtain ⟨rfl, rfl, rfl, rfl⟩ := hmem5
                cases hsub6 with
                | intC_step hmem6 hne6 hsub7 =>
                  simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem6
                  obtain ⟨rfl, rfl, rfl, rfl⟩ := hmem6
                  cases hsub7

-- Style-B hfa facts for the grafted chain + top levels
/-- One-message prunability fact. -/
theorem hfaAT : ∀ (pm : Role) (lab0 : Lab) (S0 : DataSort),
    ExposedFrom AT pm lab0 S0 → PrunableOneMsg pm lab0 S0 AT := by
  intro pm lab0 S0 _
  apply prunable_one_msg_extC_of_step "C_A" _ pm lab0 S0
  intro V hS
  cases hS with
  | @extCQ _ _ x _ hmem hHas =>
    obtain ⟨l, s, U⟩ := x
    simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem
    obtain ⟨rfl, rfl, rfl⟩ := hmem
    exact prunable_one_msg_end _ _ _
