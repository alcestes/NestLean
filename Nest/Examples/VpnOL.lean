-- Lead-to for C_B's Term via Acc fast-forward (shape-2 states).
theorem vpnOL_leadTerm (path : InfiniteNetworkPath) (hfair : IsFair path)
    (h0 : path.seq 0 = Net) (hWF0 : (path.seq 0).WellFormed)
    (i : ℕ) (Q Q1 Q2 : Queue)
    (hCB : (("C_B" : Role), (BTEg, Q)) ∈ path.seq i)
    (hT : Q.dequeue (QueueMessage.msg "C_A" "Term" "unit") = some Q1)
    (hA : Q.dequeue (QueueMessage.msg "Auth" "Acc" "unit") = some Q2) :
    ∃ k, i ≤ k ∧ path.δ k = net_label.τ_dequeue "C_B" "C_A" "Term" "unit" := by
  have hWFall := vpnOL_wf_all hWF0
  have hSTacc : st_trans BTEg (st_label.inp "Auth" "Acc" "unit") BRRec :=
    st_transb_sound (n := 4) (by decide)
  have hQdeqAcc : Queue.dequeue Q (QueueMessage.msg "Auth" "Acc" "unit") = some Q2 := hA
  have hmemSeqAcc : ("C_B", (BTEg, Q)) ∈ path.seq i := hCB
  have hTrAcc : net_trans (path.seq i) (net_label.τ_dequeue "C_B" "Auth" "Acc" "unit") ((path.seq i).replace "C_B" (BRRec, Q2)) :=
    net_trans.dequeue (sq_trans.dequeue hSTacc hQdeqAcc) hmemSeqAcc
  obtain ⟨k, hk_le, hk_eq⟩ := (hfair i).2 "C_B" "Auth" "Acc" "unit" ⟨_, hTrAcc⟩
  have hem := Classical.em (∃ j, i ≤ j ∧ j < k ∧ path.δ j = net_label.τ_dequeue "C_B" "C_A" "Term" "unit")
  rcases hem with hF | hF
  · obtain ⟨j, hj_le, hj_lt, hfire⟩ := hF
    exact ⟨j, hj_le, hfire⟩
  · have hno : ∀ j, i ≤ j → j < k → path.δ j ≠ net_label.τ_dequeue "C_B" "C_A" "Term" "unit" := by
      intro j hj1 hj2 heq
      exact hF ⟨j, hj1, hj2, heq⟩
    obtain ⟨Qk, ⟨Tk, hmemk⟩, Qk1, hQk⟩ := vpnOL_termPersist hWFall i k hk_le hno Q ⟨Q1, hT⟩ ⟨BTEg, hCB⟩
    have hStark : net_trans_star Net (path.seq k) := path_star_reachable h0 k
