import Nest.Examples.VpnHD
import Nest.NetworkLiveness
import Nest.DrainNonLiveness

set_option maxRecDepth 10000
set_option maxHeartbeats 5000000

namespace Vpn

/-! Manual queue-persistence layer for `VpnOL`.

The plain AF-tree recipe (Game/Store) fails on 20 `(class, C_B, Term)` roots:
finite trees cannot discharge unfair loops. The generated `vpnOL_leadTerm`
fast-forwards on the enabled `Acc`-dequeue and needs: (a) role-entry
uniqueness, (b) `WellFormed` at every path position, (c) single-removal
preservation of dequeueability, (d) persistence of a dequeueable message
across a segment with no firing of its own dequeue. -/

-- Entry uniqueness from well-formedness (no duplicate roles).
private theorem entry_unique_aux : ∀ (L : Network),
    List.Nodup (List.map (fun x : Role × SessionTypeWithQueue => x.1) L) →
    ∀ {r : Role} {s1 s2 : SessionTypeWithQueue},
      (r, s1) ∈ L → (r, s2) ∈ L → s1 = s2 := by
  intro L
  induction L with
  | nil =>
    intro _ _ _ _ h1
    simp at h1
  | cons hd tl ih =>
    intro hNodup r s1 s2 h1 h2
    simp only [List.map_cons, List.nodup_cons] at hNodup
    rcases hNodup with ⟨hnotin, hnodup_tl⟩
    simp only [List.mem_cons] at h1 h2
    rcases h1 with h1 | h1 <;> rcases h2 with h2 | h2
    · have hEq : (r, s1) = (r, s2) := h1.trans h2.symm
      exact congrArg (fun x : Role × SessionTypeWithQueue => x.2) hEq
    · have hr : hd.1 = r :=
        (congrArg (fun x : Role × SessionTypeWithQueue => x.1) h1).symm
      rw [hr] at hnotin
      have hmem : r ∈ List.map (fun x : Role × SessionTypeWithQueue => x.1) tl :=
        List.mem_map.mpr ⟨(r, s2), h2, rfl⟩
      exact absurd hmem hnotin
    · have hr : hd.1 = r :=
        (congrArg (fun x : Role × SessionTypeWithQueue => x.1) h2).symm
      rw [hr] at hnotin
      have hmem : r ∈ List.map (fun x : Role × SessionTypeWithQueue => x.1) tl :=
        List.mem_map.mpr ⟨(r, s1), h1, rfl⟩
      exact absurd hmem hnotin
    · exact ih hnodup_tl h1 h2

theorem Network.entry_unique {N : Network} (hWF : N.WellFormed)
    {r : Role} {s1 s2 : SessionTypeWithQueue}
    (h1 : (r, s1) ∈ N) (h2 : (r, s2) ∈ N) : s1 = s2 := by
  rcases hWF with ⟨hNodup, -, -⟩
  exact entry_unique_aux N hNodup h1 h2

-- Well-formedness at every position of an infinite path.
theorem vpnOL_wf_all {path : InfiniteNetworkPath}
    (hWF0 : (path.seq 0).WellFormed) : ∀ n, (path.seq n).WellFormed := by
  intro n
  induction n with
  | zero => exact hWF0
  | succ k ih =>
    obtain ⟨r, p, lab, S, h | h⟩ := path.δ_form k
    · have hTr := path.δ_tr k
      rw [h] at hTr
      exact Network.wellFormedPreserved _ _ _ ih hTr
        (by simp [is_internal_net_label])
    · have hTr := path.δ_tr k
      rw [h] at hTr
      exact Network.wellFormedPreserved _ _ _ ih hTr
        (by simp [is_internal_net_label])

-- Membership helpers for `Network.replace`.
theorem Network.mem_replace_head (N : Network) (r : Role)
    (stq : SessionTypeWithQueue) :
    (r, stq) ∈ Network.replace N r stq := by
  simp [Network.replace]

theorem Network.mem_replace_of_mem_ne {N : Network}
    {r r2 : Role} {st stq : SessionTypeWithQueue}
    (h : (r, st) ∈ N) (hne : r ≠ r2) :
    (r, st) ∈ Network.replace N r2 stq := by
  simp only [Network.replace, List.mem_cons, List.mem_filter]
  right
  refine ⟨h, ?_⟩
  show ((r, st).1 != r2) = true
  simp only []
  rw [bne_iff_ne]
  simpa using hne

-- Split characterization of a successful `dequeue.go` scan: the message is
-- found after a sender-free prefix, and the result is `seen ++ pre ++ post`.
private theorem dequeue_go_split : ∀ (seen left : Queue) (m : QueueMessage)
    {R : Queue}, Queue.dequeue.go seen left m = some R →
    ∃ pre post, left = pre ++ [m] ++ post ∧
      (∀ y ∈ pre, y.1 ≠ m.1) ∧ R = seen ++ pre ++ post := by
  intro seen left
  induction left generalizing seen with
  | nil =>
    intro m R h
    simp [Queue.dequeue.go] at h
  | cons z zs ih =>
    intro m R h
    by_cases hzm : z = m
    · subst hzm
      simp only [Queue.dequeue.go, ↓reduceIte] at h
      exact ⟨[], zs, by simp, by simp, by simpa using h.symm⟩
    · by_cases hzs : z.1 = m.1
      · simp [Queue.dequeue.go, hzm, hzs] at h
      · simp only [Queue.dequeue.go, hzm, hzs, ↓reduceIte] at h
        obtain ⟨pre, post, hsplit, hfree, hR⟩ := ih _ _ h
        refine ⟨z :: pre, post, by simp [hsplit], ?_, ?_⟩
        · intro y hy
          simp only [List.mem_cons] at hy
          rcases hy with rfl | hy
          · exact hzs
          · exact hfree y hy
        · have hass : (seen ++ [z]) ++ pre ++ post
              = seen ++ (z :: pre) ++ post := by
            simp [List.append_assoc]
          rw [hass] at hR
          exact hR

-- Creating a scan result: skipping a sender-clean prefix then matching head.
private theorem dequeue_go_create : ∀ (seen rest : Queue) (m : QueueMessage)
    (acc : Queue), (∀ y ∈ seen, y ≠ m ∧ y.1 ≠ m.1) →
    Queue.dequeue.go acc (seen ++ (m :: rest)) m =
      some ((acc ++ seen) ++ rest) := by
  intro seen rest m acc hcl
  induction seen generalizing acc with
  | nil =>
    simp [Queue.dequeue.go]
  | cons y ys ih =>
    have hy : y ≠ m ∧ y.1 ≠ m.1 := hcl y (List.mem_cons.mpr (Or.inl rfl))
    have htl : ∀ y_ ∈ ys, y_ ≠ m ∧ y_.1 ≠ m.1 := by
      intro y_ hy_
      exact hcl y_ (List.mem_cons.mpr (Or.inr hy_))
    simp only [List.cons_append]
    have hskip : Queue.dequeue.go acc (y :: (ys ++ m :: rest)) m
        = Queue.dequeue.go (acc ++ [y]) (ys ++ m :: rest) m := by
      simp only [Queue.dequeue.go, hy.1, hy.2, ↓reduceIte]
    rw [hskip]
    have hass : ((acc ++ [y]) ++ ys) ++ rest = (acc ++ y :: ys) ++ rest := by
      simp [List.append_assoc]
    rw [← hass]
    exact ih _ htl

-- Single-removal preservation: removing a different fireable message keeps a
-- dequeueable message dequeueable.
private theorem dequeue_remove_other_aux (m2 mT : QueueMessage)
    (hne : m2 ≠ mT) (seen : Queue)
    (hcl : ∀ y ∈ seen, y ≠ mT ∧ y.1 ≠ mT.1) : ∀ (Q : Queue)
    (A : Queue), Queue.dequeue.go seen Q mT = some A →
    ∀ (B : Queue), Queue.dequeue.go seen Q m2 = some B →
    ∃ C, Queue.dequeue B mT = some C := by
  intro Q
  induction Q generalizing seen hcl with
  | nil =>
    intro A hT
    simp [Queue.dequeue.go] at hT
  | cons z zs ih =>
    intro A hT B h2
    by_cases hzm : z = mT
    · -- Head is the target: the other scan must skip it; rescan finds it.
      subst hzm
      have hzm2 : z ≠ m2 := fun heq => hne heq.symm
      by_cases hzs2 : z.1 = m2.1
      · simp [Queue.dequeue.go, hzm2, hzs2] at h2
      · simp only [Queue.dequeue.go, hzm2, hzs2, ↓reduceIte] at h2
        obtain ⟨pre2, post2, -, -, hB⟩ := dequeue_go_split _ _ _ h2
        have hBshape : B = seen ++ ([z] ++ pre2 ++ post2) := by
          have hass : (seen ++ [z]) ++ pre2 ++ post2
              = seen ++ ([z] ++ pre2 ++ post2) := by
            simp [List.append_assoc]
          rw [hass] at hB
          exact hB
        have hgoal := dequeue_go_create seen (pre2 ++ post2) z [] hcl
        simp only [List.nil_append] at hgoal
        rw [hBshape]
        rw [show [z] ++ pre2 ++ post2 = z :: (pre2 ++ post2) from rfl]
        exact ⟨_, hgoal⟩
    · by_cases hzs : z.1 = mT.1
      · simp [Queue.dequeue.go, hzm, hzs] at hT
      · simp only [Queue.dequeue.go, hzm, hzs, ↓reduceIte] at hT
        -- hT : go (seen ++ [z]) zs mT = some A
        by_cases hzm2 : z = m2
        · -- The other scan stops here: B = seen ++ zs; rescan via split.
          subst hzm2
          simp only [Queue.dequeue.go, ↓reduceIte] at h2
          obtain ⟨pre, post, hsplit, hfree, -⟩ := dequeue_go_split _ _ _ hT
          have hclean : ∀ y ∈ seen ++ pre, y ≠ mT ∧ y.1 ≠ mT.1 := by
            intro y hy
            simp only [List.mem_append] at hy
            rcases hy with hy | hy
            · exact hcl y hy
            · have h1 := hfree y hy
              exact ⟨fun heq => h1 (by rw [heq]), h1⟩
          have hgoal := dequeue_go_create (seen ++ pre) post mT [] hclean
          simp only [List.nil_append] at hgoal
          have hBshape : B = seen ++ zs := by
            cases h2
            rfl
          rw [hBshape, hsplit]
          simp only [Queue.dequeue]
          have hargs : seen ++ (pre ++ [mT] ++ post)
              = (seen ++ pre) ++ (mT :: post) := by
            simp [List.append_assoc]
          rw [hargs]
          exact ⟨_, hgoal⟩
        · by_cases hzs2 : z.1 = m2.1
          · simp [Queue.dequeue.go, hzm2, hzs2] at h2
          · simp only [Queue.dequeue.go, hzm2, hzs2, ↓reduceIte] at h2
            -- Both descend: apply IH with extended accumulator.
            have hclean : ∀ y ∈ seen ++ [z], y ≠ mT ∧ y.1 ≠ mT.1 := by
              intro y hy
              simp only [List.mem_append, List.mem_singleton] at hy
              rcases hy with hy | rfl
              · exact hcl y hy
              · exact ⟨hzm, hzs⟩
            obtain ⟨C, hC⟩ := ih _ hclean _ hT _ h2
            exact ⟨C, hC⟩

theorem Queue.dequeue_remove_other {Q : Queue} {m2 mT : QueueMessage}
    (hne : m2 ≠ mT)
    {A : Queue} (hT : Queue.dequeue Q mT = some A)
    {B : Queue} (h2 : Queue.dequeue Q m2 = some B) :
    ∃ C, Queue.dequeue B mT = some C := by
  have hT' : Queue.dequeue.go [] Q mT = some A := by
    simpa [Queue.dequeue] using hT
  have h2' : Queue.dequeue.go [] Q m2 = some B := by
    simpa [Queue.dequeue] using h2
  have hclean : ∀ y ∈ ([] : Queue), y ≠ mT ∧ y.1 ≠ mT.1 := by
    intro y hy
    simp at hy
  exact dequeue_remove_other_aux _ _ hne [] hclean Q _ hT' _ h2'

-- Step inversion lemmas (all indices are variables, so `cases` substitutes).
-- A dequeue of another role preserves entries.
theorem step_entry_deq_other {N N' : Network} {r r2 p2 lab2 S2}
    {st : SessionTypeWithQueue}
    (hTr : net_trans N (net_label.τ_dequeue r2 p2 lab2 S2) N')
    (hmem : (r, st) ∈ N) (hne : r ≠ r2) :
    (r, st) ∈ N' := by
  cases hTr with
  | @dequeue _ _ stq stq' _ _ _ _ =>
    exact Network.mem_replace_of_mem_ne hmem hne

-- A dequeue of the tracked role: target equation, `st_trans` witness, and queue transformation.
theorem step_deq_self {N N' : Network} (hWFN : N.WellFormed)
    {r2 p2 lab2 S2 T2 Q2}
    (hTr : net_trans N (net_label.τ_dequeue r2 p2 lab2 S2) N')
    (hmem : (r2, (T2, Q2)) ∈ N) :
    ∃ T2' Q2', N' = Network.replace N r2 (T2', Q2') ∧
      st_trans T2 (st_label.inp p2 lab2 S2) T2' ∧
      Q2.dequeue (QueueMessage.msg p2 lab2 S2) = some Q2' := by
  cases hTr with
  | @dequeue _ _ stq stq' _ _ hSQ hmemStep =>
    cases hSQ with
    | @dequeue T T' Q Q' _ _ _ hST hQ =>
      have hstq : (T2, Q2) = (T, Q) :=
        Network.entry_unique (s2 := (T, Q)) hWFN hmem hmemStep
      have hT : T2 = T := congrArg Prod.fst hstq
      have hQe : Q2 = Q := congrArg Prod.snd hstq
      subst hT
      subst hQe
      refine ⟨_, _, rfl, hST, hQ⟩

-- A comm step: target is the double replace.
theorem step_comm_target {N N' : Network} {p q lab S}
    (hTr : net_trans N (net_label.τ_comm p q lab S) N') :
    ∃ a b, N' = (Network.replace N p a).replace q b := by
  cases hTr with
  | @comm _ _ _ _ _ stqp' stqq' _ _ _ _ _ => exact ⟨_, _, rfl⟩

-- A comm delivering to the tracked role: queue grows by snoc.
theorem step_comm_recv {N N' : Network} (hWFN : N.WellFormed)
    {p q lab S Tq Qq}
    (hTr : net_trans N (net_label.τ_comm p q lab S) N')
    (hmem_q : (q, (Tq, Qq)) ∈ N) :
    ∃ Tp' Qp', N' = (Network.replace N p (Tp', Qp')).replace q
      (Tq, Qq ++ [QueueMessage.msg p lab S]) := by
  cases hTr with
  | @comm _ _ _ _ stqp stqp' stqq stqq' _ _ h_recv hmem_p hmem_q' =>
    cases h_recv with
    | @recv T Q _ _ _ =>
      have hstqq : (Tq, Qq) = (T, Q) :=
        Network.entry_unique (s2 := (T, Q)) hWFN hmem_q hmem_q'
      have hT : Tq = T := congrArg Prod.fst hstqq
      have hQe : Qq = Q := congrArg Prod.snd hstqq
      subst hT
      subst hQe
      obtain ⟨Tp', Qp'⟩ := stqp'
      exact ⟨Tp', Qp', rfl⟩

-- A comm sent by the tracked role: its queue is unchanged.
theorem step_comm_send {N N' : Network} (hWFN : N.WellFormed)
    {p q lab S Tp Qp}
    (hTr : net_trans N (net_label.τ_comm p q lab S) N')
    (hmem_p : (p, (Tp, Qp)) ∈ N) :
    ∃ Tp' b, N' = (Network.replace N p (Tp', Qp)).replace q b := by
  cases hTr with
  | @comm _ _ _ _ stqp stqp' _ _ _ h_send _ hmem_p' _ =>
    cases h_send with
    | @send T T' Q _ _ _ hST =>
      have hstqp : (Tp, Qp) = (T, Q) :=
        Network.entry_unique (s2 := (T, Q)) hWFN hmem_p hmem_p'
      have hT : Tp = T := congrArg Prod.fst hstqp
      have hQe : Qp = Q := congrArg Prod.snd hstqp
      subst hT
      subst hQe
      exact ⟨_, _, rfl⟩

-- Persistence: a dequeueable message stays dequeueable across a segment with
-- no firing of its own dequeue (other dequeues only remove different
-- messages; comms only append; other roles' steps leave the queue alone).
theorem vpnOL_termPersist {path : InfiniteNetworkPath}
    (hWF : ∀ n, (path.seq n).WellFormed)
    (i k : ℕ) (hik : i ≤ k)
    (hno : ∀ j, i ≤ j → j < k → path.δ j ≠ net_label.τ_dequeue "C_B" "C_A" "Term" "unit")
    (Q : Queue) (hT : ∃ Q1, Q.dequeue (QueueMessage.msg "C_A" "Term" "unit") = some Q1)
    (hmem : ∃ T, ((("C_B" : Role), (T, Q)) ∈ path.seq i)) :
    ∃ Q', (∃ T', ((("C_B" : Role), (T', Q')) ∈ path.seq k)) ∧
      (∃ Q1', Q'.dequeue (QueueMessage.msg "C_A" "Term" "unit") = some Q1') := by
  obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hik
  clear hik
  revert hno
  induction d with
  | zero =>
    intro hno
    exact ⟨Q, hmem, hT⟩
  | succ d ih =>
    intro hno
    have hno' : ∀ j, i ≤ j → j < i + d →
        path.δ j ≠ net_label.τ_dequeue "C_B" "C_A" "Term" "unit" := by
      intro j hj1 hj2
      exact hno j hj1 (by omega)
    obtain ⟨Qd, ⟨Td, hmemd⟩, Qd1, hQd⟩ := ih hno'
    have hWFd := hWF (i + d)
    have hno_k : path.δ (i + d) ≠ net_label.τ_dequeue "C_B" "C_A" "Term" "unit" :=
      hno _ (by omega) (by omega)
    obtain ⟨r2, p2, lab2, S2, hδ | hδ⟩ := path.δ_form (i + d)
    · -- Dequeue step.
      have hTr := path.δ_tr (i + d)
      rw [hδ] at hTr hno_k
      by_cases hrC : r2 = "C_B"
      · -- Own dequeue of a different message: removal preserves dequeueability.
        subst hrC
        obtain ⟨T2', Q2', hN', _, hQ'⟩ := step_deq_self hWFd hTr hmemd
        have hmsg : QueueMessage.msg p2 lab2 S2 ≠ QueueMessage.msg "C_A" "Term" "unit" := by
          intro heq
          cases heq
          exact absurd rfl hno_k
        obtain ⟨Q', hQ''⟩ := Queue.dequeue_remove_other hmsg hQd hQ'
        have hmem' : ((("C_B" : Role), (T2', Q2')) ∈ path.seq ((i + d) + 1)) := by
          rw [hN']
          exact Network.mem_replace_head _ _ _
        exact ⟨Q2', ⟨T2', hmem'⟩, Q', hQ''⟩
      · -- Another role's dequeue: entry preserved.
        have hmem' : ((("C_B" : Role), (Td, Qd)) ∈ path.seq ((i + d) + 1)) :=
          step_entry_deq_other hTr hmemd (Ne.symm hrC)
        exact ⟨Qd, ⟨Td, hmem'⟩, Qd1, hQd⟩
    · -- Comm step.
      have hTr := path.δ_tr (i + d)
      rw [hδ] at hTr
      by_cases hqC : p2 = "C_B"
      · -- Delivery to C_B: snoc preserves dequeueability.
        subst hqC
        obtain ⟨Tp', Qp', hN'⟩ := step_comm_recv hWFd hTr hmemd
        have hQapp := dequeue_appendList [QueueMessage.msg r2 lab2 S2] hQd
        have hmem' : ((("C_B" : Role), (Td, Qd ++ [QueueMessage.msg r2 lab2 S2])) ∈
            path.seq ((i + d) + 1)) := by
          rw [hN']
          exact Network.mem_replace_head _ _ _
        exact ⟨Qd ++ [QueueMessage.msg r2 lab2 S2], ⟨Td, hmem'⟩, _, hQapp⟩
      · -- Another role's comm: entry preserved (sender queue unchanged).
        by_cases hpC : r2 = "C_B"
        · subst hpC
          obtain ⟨Tp', b, hN'⟩ := step_comm_send hWFd hTr hmemd
          have hmem' : ((("C_B" : Role), (Tp', Qd)) ∈ path.seq ((i + d) + 1)) := by
            rw [hN']
            exact Network.mem_replace_of_mem_ne
              (Network.mem_replace_head _ _ _) (Ne.symm hqC)
          exact ⟨Qd, ⟨Tp', hmem'⟩, Qd1, hQd⟩
        · obtain ⟨a, b, hN'⟩ := step_comm_target hTr
          have hmem1 : ((("C_B" : Role), (Td, Qd)) ∈
              Network.replace (path.seq (i + d)) r2 a) :=
            Network.mem_replace_of_mem_ne hmemd (Ne.symm hpC)
          have hmem' : ((("C_B" : Role), (Td, Qd)) ∈ path.seq ((i + d) + 1)) := by
            rw [hN']
            exact Network.mem_replace_of_mem_ne hmem1 (Ne.symm hqC)
          exact ⟨Qd, ⟨Td, hmem'⟩, Qd1, hQd⟩

-- Exact single-step tables per canonical state (label + target class).
theorem CS_0_stepexact : ∀ (δ : net_label) (N' : Network),
    net_trans CS_0 δ N' → is_internal_net_label δ → False := by
  intro δ N' hTr hInt
  cases hTr with
  | io_send h hmem => simp [is_internal_net_label] at hInt
  | io_recv h hmem => simp [is_internal_net_label] at hInt
  | dequeue hSQ hmem =>
    simp only [CS_0, List.mem_cons, List.mem_nil_iff, or_false] at hmem
    rcases hmem with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · cases hSQ with
      | dequeue hST hQ =>
        simp [Queue.dequeue, Queue.dequeue.go] at hQ
    · cases hSQ with
      | dequeue hST hQ =>
        simp [Queue.dequeue, Queue.dequeue.go] at hQ
    · cases hSQ with
      | dequeue hST hQ =>
        simp [Queue.dequeue, Queue.dequeue.go] at hQ
    · cases hSQ with
      | dequeue hST hQ =>
        simp [Queue.dequeue, Queue.dequeue.go] at hQ
  | comm hne h_send h_recv hmem_p hmem_q =>
    simp only [CS_0, List.mem_cons, List.mem_nil_iff, or_false] at hmem_p hmem_q
    rcases hmem_p with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ <;>
      rcases hmem_q with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · cases h_send with
      | send hST => exact absurd rfl hne
    · cases h_send with
      | send hST =>
        cases h_recv with
        | recv =>
          exact absurd hST (fun h => tEnd_no_out_vpn h)
    · cases h_send with
      | send hST =>
        cases h_recv with
        | recv =>
          exact absurd hST (fun h => tEnd_no_out_vpn h)
    · cases h_send with
      | send hST =>
        cases h_recv with
        | recv =>
          exact absurd hST (fun h => tEnd_no_out_vpn h)
    · cases h_send with
      | send hST =>
        cases h_recv with
        | recv =>
          exact absurd hST (fun h => tEnd_no_out_vpn h)
    · cases h_send with
      | send hST => exact absurd rfl hne
    · cases h_send with
      | send hST =>
        cases h_recv with
        | recv =>
          exact absurd hST (fun h => tEnd_no_out_vpn h)
    · cases h_send with
      | send hST =>
        cases h_recv with
        | recv =>
          exact absurd hST (fun h => tEnd_no_out_vpn h)
    · cases h_send with
      | send hST =>
        cases h_recv with
        | recv =>
          exact absurd hST (fun h => tEnd_no_out_vpn h)
    · cases h_send with
      | send hST =>
        cases h_recv with
        | recv =>
          exact absurd hST (fun h => tEnd_no_out_vpn h)
    · cases h_send with
      | send hST => exact absurd rfl hne
    · cases h_send with
      | send hST =>
        cases h_recv with
        | recv =>
          exact absurd hST (fun h => tEnd_no_out_vpn h)
    · cases h_send with
      | send hST =>
