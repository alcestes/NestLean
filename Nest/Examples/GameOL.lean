import Nest.Examples.GameHD

set_option maxRecDepth 10000
set_option maxHeartbeats 5000000

namespace Game

-- Exact single-step tables per canonical state (label + target class).
theorem CS_0_stepexact : ∀ (δ : net_label) (N' : Network),
    net_trans CS_0 δ N' → is_internal_net_label δ → False := by
  intro δ N' hTr hInt
  cases hTr with
  | io_send h hmem => simp [is_internal_net_label] at hInt
  | io_recv h hmem => simp [is_internal_net_label] at hInt
  | dequeue hSQ hmem =>
    simp only [CS_0, List.mem_cons, List.mem_nil_iff, or_false] at hmem
    rcases hmem with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · cases hSQ with
      | dequeue hST hQ =>
        simp [Queue.dequeue, Queue.dequeue.go] at hQ
    · cases hSQ with
      | dequeue hST hQ =>
        simp [Queue.dequeue, Queue.dequeue.go] at hQ
    · cases hSQ with
      | dequeue hST hQ =>
        simp [Queue.dequeue, Queue.dequeue.go] at hQ
    · cases hSQ with
      | dequeue hST hQ =>
        simp [Queue.dequeue, Queue.dequeue.go] at hQ
  | comm hne h_send h_recv hmem_p hmem_q =>
    simp only [CS_0, List.mem_cons, List.mem_nil_iff, or_false] at hmem_p hmem_q
    rcases hmem_p with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ <;>
      rcases hmem_q with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · cases h_send with
      | send hST => exact absurd rfl hne
    · cases h_send with
      | send hST =>
        cases h_recv with
        | recv =>
          exact absurd hST (fun h => tEnd_no_out_game h)
    · cases h_send with
      | send hST =>
        cases h_recv with
        | recv =>
          exact absurd hST (fun h => tEnd_no_out_game h)
    · cases h_send with
      | send hST =>
        cases h_recv with
        | recv =>
          exact absurd hST (fun h => tEnd_no_out_game h)
    · cases h_send with
      | send hST =>
        cases h_recv with
        | recv =>
          exact absurd hST (fun h => tEnd_no_out_game h)
    · cases h_send with
      | send hST => exact absurd rfl hne
    · cases h_send with
      | send hST =>
        cases h_recv with
        | recv =>
          exact absurd hST (fun h => tEnd_no_out_game h)
    · cases h_send with
      | send hST =>
        cases h_recv with
        | recv =>
          exact absurd hST (fun h => tEnd_no_out_game h)
    · cases h_send with
      | send hST =>
        cases h_recv with
        | recv =>
          exact absurd hST (fun h => tEnd_no_out_game h)
    · cases h_send with
      | send hST =>
        cases h_recv with
        | recv =>
          exact absurd hST (fun h => tEnd_no_out_game h)
    · cases h_send with
      | send hST => exact absurd rfl hne
    · cases h_send with
      | send hST =>
        cases h_recv with
        | recv =>
          exact absurd hST (fun h => tEnd_no_out_game h)
    · cases h_send with
      | send hST =>
        cases h_recv with
        | recv =>
          exact absurd hST (fun h => tEnd_no_out_game h)
    · cases h_send with
      | send hST =>
        cases h_recv with
        | recv =>
          exact absurd hST (fun h => tEnd_no_out_game h)
    · cases h_send with
