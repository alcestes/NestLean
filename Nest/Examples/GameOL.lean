    · obtain ⟨Q', hQ⟩ := hdeq
      simp [Queue.dequeue, Queue.dequeue.go] at hQ
    · obtain ⟨Q', hQ⟩ := hdeq
      simp [Queue.dequeue, Queue.dequeue.go] at hQ
    · obtain ⟨Q', hQ⟩ := hdeq
      have hmem : QueueMessage.msg q lab S ∈ [QueueMessage.msg "GameServer" "YouLost" "unit"] := Queue.dequeue_mem hQ
      simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem
      have hq : q = "GameServer" := congrArg (fun m => m.1) hmem
      have hlab : lab = "YouLost" := congrArg (fun m => m.2) hmem
      have hS : S = "unit" := congrArg (fun m => m.3) hmem
      subst hq; subst hlab; subst hS
      -- direct fairness (enabled now)
      have hST : st_trans PRec (st_label.inp "GameServer" "YouLost" "unit") SessionType.tEnd := st_transb_sound (n := 4) (by decide)
      have hQdeq : Queue.dequeue [QueueMessage.msg "GameServer" "YouLost" "unit"] (QueueMessage.msg "GameServer" "YouLost" "unit") = some [] := by decide
      have hmemSeq : ("Player_2", (PRec, [QueueMessage.msg "GameServer" "YouLost" "unit"])) ∈ path.seq i := (Network.mem_reordered hperm).mpr (by simp [CS_1])
      have hTr : net_trans (path.seq i) (net_label.τ_dequeue "Player_2" "GameServer" "YouLost" "unit") ((path.seq i).replace "Player_2" (SessionType.tEnd, [])) := net_trans.dequeue (sq_trans.dequeue hST hQdeq) hmemSeq
      obtain ⟨k, hk_le, hk_eq⟩ := (hfair i).2 "Player_2" "GameServer" "YouLost" "unit" ⟨_, hTr⟩
