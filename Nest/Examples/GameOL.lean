    simp only [CS_108, List.mem_cons, List.mem_nil_iff, or_false] at hPC
    rcases hPC with ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩
    · obtain ⟨Q', hQ⟩ := hdeq
      simp [Queue.dequeue, Queue.dequeue.go] at hQ
    · obtain ⟨Q', hQ⟩ := hdeq
      simp [Queue.dequeue, Queue.dequeue.go] at hQ
    · obtain ⟨Q', hQ⟩ := hdeq
      simp [Queue.dequeue, Queue.dequeue.go] at hQ
    · obtain ⟨Q', hQ⟩ := hdeq
      have hmem : QueueMessage.msg q lab S ∈ [QueueMessage.msg "Coordinator" "Init" "unit"] := Queue.dequeue_mem hQ
      simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem
      have hq : q = "Coordinator" := congrArg (fun m => m.1) hmem
      have hlab : lab = "Init" := congrArg (fun m => m.2) hmem
      have hS : S = "unit" := congrArg (fun m => m.3) hmem
      subst hq; subst hlab; subst hS
      -- direct fairness (enabled now)
      have hST : st_trans Player (st_label.inp "Coordinator" "Init" "unit") PL := st_transb_sound (n := 4) (by decide)
      have hQdeq : Queue.dequeue [QueueMessage.msg "Coordinator" "Init" "unit"] (QueueMessage.msg "Coordinator" "Init" "unit") = some [] := by decide
      have hmemSeq : ("Player_2", (Player, [QueueMessage.msg "Coordinator" "Init" "unit"])) ∈ path.seq i := (Network.mem_reordered hperm).mpr (by simp [CS_108])
      have hTr : net_trans (path.seq i) (net_label.τ_dequeue "Player_2" "Coordinator" "Init" "unit") ((path.seq i).replace "Player_2" (PL, [])) := net_trans.dequeue (sq_trans.dequeue hST hQdeq) hmemSeq
      obtain ⟨k, hk_le, hk_eq⟩ := (hfair i).2 "Player_2" "Coordinator" "Init" "unit" ⟨_, hTr⟩
      exact ⟨k, by omega, hk_eq⟩

