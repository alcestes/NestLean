/-- Empty-queue network for the seven store roles. -/
def Net : Network :=
  [("ExternalClient", (Client, [])),
   ("HTTP_Gateway", (HTTP, [])),
   ("Inventory", (Inventory, [])),
   ("Payment", (Payment, [])),
   ("Shipping", (Shipping, [])),
   ("ExternalBank", (Bank, [])),
   ("ExternalMailserver", (Email, []))]

/-- `Net` is well-formed: distinct roles, well-formed types, vacuous sender-closure. -/
theorem Net_wellFormed : Net.WellFormed := by
  refine ⟨by decide, ?_, Network.SenderClosed_of_all_nil (by decide)⟩
  intro x hx
  simp only [Net, List.mem_cons, List.mem_nil_iff, or_false] at hx
  rcases hx with rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact Client.wfCheck_sound (by decide)
  · exact HTTP.wfCheck_sound (by decide)
  · exact Inventory.wfCheck_sound (by decide)
  · exact Payment.wfCheck_sound (by decide)
  · exact Shipping.wfCheck_sound (by decide)
  · exact Bank.wfCheck_sound (by decide)
  · exact Email.wfCheck_sound (by decide)

/-- `Net` has no self-mention: each role is absent from its own type. -/
theorem Net_noSelf : Net.NoSelf := by
  apply Network.NoSelf_of_rolesOf
  intro x hx
  simp only [Net, List.mem_cons, List.mem_nil_iff, or_false] at hx
  rcases hx with rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> decide

/-- `Net` contains every role occurring in its member types. -/
theorem Net_rolesPresent : Net.RolesPresent := by
  intro q T Q s hmem hOcc
  have hmemR : s ∈ rolesOf T := occurs_mem hOcc
  simp only [Net, List.mem_cons, List.mem_nil_iff, or_false] at hmem
  rcases hmem with ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩
  · simp only [Client, rolesOf, rolesOf.goInt, rolesOf.goExt,
      List.mem_append, List.mem_cons, List.mem_nil_iff, or_false] at hmemR
    have hs : s = "HTTP_Gateway" := by tauto
    subst hs
    exact ⟨(HTTP, []), by decide⟩
  · simp only [HTTP, rolesOf, rolesOf.goInt, rolesOf.goExt,
      List.mem_append, List.mem_cons, List.mem_nil_iff, or_false] at hmemR
    have h : s = "ExternalClient" ∨ s = "Inventory" ∨ s = "Payment" := by tauto
    rcases h with rfl | rfl | rfl
    · exact ⟨(Client, []), by decide⟩
    · exact ⟨(Inventory, []), by decide⟩
    · exact ⟨(Payment, []), by decide⟩
  · simp only [Inventory, rolesOf, rolesOf.goInt, rolesOf.goExt,
      List.mem_append, List.mem_cons, List.mem_nil_iff, or_false] at hmemR
    have h : s = "HTTP_Gateway" ∨ s = "Shipping" := by tauto
    rcases h with rfl | rfl
    · exact ⟨(HTTP, []), by decide⟩
    · exact ⟨(Shipping, []), by decide⟩
  · simp only [Payment, rolesOf, rolesOf.goInt, rolesOf.goExt,
      List.mem_append, List.mem_cons, List.mem_nil_iff, or_false] at hmemR
    have h : s = "HTTP_Gateway" ∨ s = "ExternalBank" := by tauto
    rcases h with rfl | rfl
    · exact ⟨(HTTP, []), by decide⟩
    · exact ⟨(Bank, []), by decide⟩
  · simp only [Shipping, rolesOf, rolesOf.goInt, rolesOf.goExt,
      List.mem_append, List.mem_cons, List.mem_nil_iff, or_false] at hmemR
    have h : s = "Inventory" ∨ s = "ExternalMailserver" := by tauto
    rcases h with rfl | rfl
    · exact ⟨(Inventory, []), by decide⟩
    · exact ⟨(Email, []), by decide⟩
  · simp only [Bank, rolesOf, rolesOf.goExt,
      List.mem_append, List.mem_cons, List.mem_nil_iff, or_false] at hmemR
    have hs : s = "Payment" := by tauto
    subst hs
    exact ⟨(Payment, []), by decide⟩
  · simp only [Email, rolesOf, rolesOf.goInt, rolesOf.goExt,
      List.mem_append, List.mem_cons, List.mem_nil_iff, or_false] at hmemR
    have hs : s = "Shipping" := by tauto
    subst hs
    exact ⟨(Shipping, []), by decide⟩

/-- `Net` admits a consistent coinductive instrumentation (empty queues fold trivially). -/
theorem Net_consistent : ∃ MN, consistentInstrumentation_co Net = some MN :=
  exists_consistentInstrumentation_co_of_all_nil Net (by decide)

-- ============ Store network messages ============
abbrev mECCancelOrder : QueueMessage := QueueMessage.msg "ExternalClient" "CancelOrder" "unit"
abbrev mECConfirmOrder : QueueMessage := QueueMessage.msg "ExternalClient" "ConfirmOrder" "unit"
abbrev mECPlaceOrder : QueueMessage := QueueMessage.msg "ExternalClient" "PlaceOrder" "unit"
abbrev mEMSuccess : QueueMessage := QueueMessage.msg "ExternalMailserver" "Success" "unit"
abbrev mHGCancel : QueueMessage := QueueMessage.msg "HTTP_Gateway" "Cancel" "unit"
abbrev mHGGetSKUDetails : QueueMessage := QueueMessage.msg "HTTP_Gateway" "GetSKUDetails" "unit"
abbrev mHGInvalidCC : QueueMessage := QueueMessage.msg "HTTP_Gateway" "InvalidCC" "unit"
abbrev mHGMakeCharge : QueueMessage := QueueMessage.msg "HTTP_Gateway" "MakeCharge" "unit"
abbrev mHGMakeOrder : QueueMessage := QueueMessage.msg "HTTP_Gateway" "MakeOrder" "unit"
abbrev mHGSKUDetails : QueueMessage := QueueMessage.msg "HTTP_Gateway" "SKUDetails" "unit"
abbrev mHGValidCC : QueueMessage := QueueMessage.msg "HTTP_Gateway" "ValidCC" "unit"
abbrev mHGVerifyCC : QueueMessage := QueueMessage.msg "HTTP_Gateway" "VerifyCC" "unit"
abbrev mInvSKUDetails : QueueMessage := QueueMessage.msg "Inventory" "SKUDetails" "unit"
abbrev mInvShipOrder : QueueMessage := QueueMessage.msg "Inventory" "ShipOrder" "unit"
abbrev mPayInvalidCC : QueueMessage := QueueMessage.msg "Payment" "InvalidCC" "unit"
abbrev mPayMakeCharge : QueueMessage := QueueMessage.msg "Payment" "MakeCharge" "unit"
abbrev mPayValidCC : QueueMessage := QueueMessage.msg "Payment" "ValidCC" "unit"
abbrev mShipSendEmail : QueueMessage := QueueMessage.msg "Shipping" "SendOrderShippedEmail" "unit"

-- ============ Session continuations (Inventory / Shipping / Email tails) ============
/-- After `MakeOrder`: ships the order, then ends. -/
def InvC : SessionType :=
  SessionType.internalChoice [("Shipping", "ShipOrder", "unit", SessionType.tEnd)]
/-- After `GetSKUDetails`: awaits `MakeOrder`, then ships. -/
def InvB : SessionType :=
  SessionType.externalChoice "HTTP_Gateway" [("MakeOrder", "unit", InvC)]
/-- After `GetSKUDetails` dequeue: sends `SKUDetails` back. -/
def InvA : SessionType :=
  SessionType.internalChoice [("HTTP_Gateway", "SKUDetails", "unit", InvB)]
/-- After `ShipOrder`: awaits `Success` from the mail server. -/
def ShipB : SessionType :=
  SessionType.externalChoice "ExternalMailserver" [("Success", "unit", SessionType.tEnd)]
/-- After `ShipOrder` dequeue: sends the shipped email. -/
def ShipA : SessionType :=
  SessionType.internalChoice [("ExternalMailserver", "SendOrderShippedEmail", "unit", ShipB)]
/-- After `SendOrderShippedEmail`: reports `Success` to Shipping. -/
def EmailA : SessionType :=
  SessionType.internalChoice [("Shipping", "Success", "unit", SessionType.tEnd)]

