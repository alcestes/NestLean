/- Session types from the NEST P4 testbed:
   `NEST/nest/nest_scala/src/main/scala/examples/02_store.scala`
   (Scala package `store`; file `02_store.scala` maps to this module
   since Lean module names may not start with a digit).
   Translated below are the seven `lst_*` local session types
   (`lst_Client`, `lst_HTTP`, `lst_Inventory`, `lst_Payment`,
   `lst_Shipping`, `lst_Bank`, `lst_Email`). Switch setup, IP rules,
   port checks and monitor wiring from `setup` are not session types
   and are not translated. Translation conventions: `IntChoice`
   branches become `internalChoice` branches
   `(agent, label, sort, cont)`; `ExtChoice` branches become
   `externalChoice` branches `(label, sort, cont)`; `Rec`/`Var`/`End`
   become `tRec`/`tVar`/`tEnd`. Agents become roles, labels stay labels.
   The Scala types carry no payload sorts, so every branch uses the
   placeholder sort `"unit"`. -/

/-- `lst_Client`. -/
def Client : SessionType :=
  SessionType.internalChoice
    [("HTTP_Gateway", "PlaceOrder", "unit",
      SessionType.externalChoice "HTTP_Gateway"
        [("SKUDetails", "unit",
          SessionType.tRec "decideOnOrder"
            (SessionType.internalChoice
              [("HTTP_Gateway", "ConfirmOrder", "unit",
                SessionType.externalChoice "HTTP_Gateway"
                  [("ValidCC", "unit", SessionType.tEnd),
                   ("InvalidCC", "unit",
                    SessionType.tVar "decideOnOrder")]),
               ("HTTP_Gateway", "CancelOrder", "unit",
                SessionType.externalChoice "HTTP_Gateway"
                  [("Cancel", "unit", SessionType.tEnd)])]))])]

/-- `lst_HTTP`. -/
def HTTP : SessionType :=
  SessionType.externalChoice "ExternalClient"
    [("PlaceOrder", "unit",
      SessionType.internalChoice
        [("Inventory", "GetSKUDetails", "unit",
          SessionType.externalChoice "Inventory"
            [("SKUDetails", "unit",
              SessionType.internalChoice
                [("ExternalClient", "SKUDetails", "unit",
                  SessionType.tRec "decideOnOrder"
                    (SessionType.externalChoice "ExternalClient"
                      [("ConfirmOrder", "unit",
                        SessionType.internalChoice
                          [("Payment", "VerifyCC", "unit",
                            SessionType.externalChoice "Payment"
                              [("ValidCC", "unit",
                                SessionType.internalChoice
                                  [("Payment", "MakeCharge", "unit",
                                    SessionType.internalChoice
                                      [("Inventory", "MakeOrder", "unit",
                                        SessionType.internalChoice
                                          [("ExternalClient", "ValidCC", "unit",
                                            SessionType.tEnd)])])]),
                               ("InvalidCC", "unit",
                                SessionType.internalChoice
                                  [("ExternalClient", "InvalidCC", "unit",
                                    SessionType.tVar "decideOnOrder")])])]),
                       ("CancelOrder", "unit",
                        SessionType.internalChoice
                          [("ExternalClient", "Cancel", "unit",
                            SessionType.tEnd)])]))])])])]

