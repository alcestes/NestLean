  intro h
  unfold Payment at h
  cases h with
  | tRec hsub =>
    have h2 : st_trans PayS (st_label.inp p lab S) T' := hsub
    unfold PayS at h2
    cases h2 with
    | extC hmem =>
      simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem
      obtain ⟨rfl, rfl, rfl⟩ := hmem
      exact ⟨rfl, rfl, rfl, rfl⟩

