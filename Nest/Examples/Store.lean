-- ============ Reachable networks (replace order) ============
-- ============ OUT/INP characterizations ============
theorem Bank_no_out {p lab : Role} {S : DataSort} {T' : SessionType}
    (h : st_trans Bank (st_label.out p lab S) T') : False := by
  unfold Bank at h
  cases h

theorem Bank_inp_iff {p : Role} {lab : Lab} {S : DataSort} {T' : SessionType} :
    st_trans Bank (st_label.inp p lab S) T' →
    p = "Payment" ∧ lab = "MakeCharge" ∧ S = "unit" ∧ T' = SessionType.tEnd := by
  intro h
  unfold Bank at h
  cases h with
  | extC hmem =>
    simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem
    obtain ⟨rfl, rfl, rfl⟩ := hmem
    exact ⟨rfl, rfl, rfl, rfl⟩

