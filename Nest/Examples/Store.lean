-- `lst_Payment`: body is an owner-head single-branch choice, so every
-- triple either misses or hits a dead head; exposures pin to two triples.
/-- External offer by `HTTP_Gateway`: `(VerifyCC, unit)` continuing into `internalChoice`;
   `(HTTP_Gateway, InvalidCC)` with a computed continuation (`Payment` mirror). -/
def PayB : SessionType :=
  SessionType.externalChoice "HTTP_Gateway"
    [("VerifyCC", "unit",
      SessionType.internalChoice
        [("HTTP_Gateway", "ValidCC", "unit",
          SessionType.externalChoice "HTTP_Gateway"
            [("MakeCharge", "unit",
              SessionType.internalChoice
                [("ExternalBank", "MakeCharge", "unit",
                  SessionType.tEnd)])]),
         ("HTTP_Gateway", "InvalidCC", "unit",
          SessionType.tVar "checkCC")])]

/-- External offer by `HTTP_Gateway`: `(MakeCharge, unit)` continuing into `internalChoice`
   (`Payment` mirror). -/
def PayTa : SessionType :=
  SessionType.externalChoice "HTTP_Gateway"
    [("MakeCharge", "unit",
      SessionType.internalChoice
        [("ExternalBank", "MakeCharge", "unit",
          SessionType.tEnd)])]

/-- Internal choice: `(HTTP_Gateway, ValidCC, unit)` continuing as `PayTa`; `(HTTP_Gateway,
   InvalidCC, unit)` continuing as `Payment` (`Payment` mirror). -/
def PayISub : SessionType :=
  SessionType.internalChoice
    [("HTTP_Gateway", "ValidCC", "unit", PayTa),
     ("HTTP_Gateway", "InvalidCC", "unit", Payment)]

/-- External offer by `HTTP_Gateway`: `(VerifyCC, unit)` continuing as `PayISub` (`Payment`
   mirror). -/
def PayS : SessionType :=
  SessionType.externalChoice "HTTP_Gateway" [("VerifyCC", "unit", PayISub)]

/-- Grafting equation: substituting `(SessionType.tRec "checkCC" PayB)` for `checkCC` in `PayB`
   yields `PayS`. -/
theorem PayS_subst :
    substSessionType PayB "checkCC" (SessionType.tRec "checkCC" PayB) = PayS := rfl

/-- One-message prunability of `PayTa` for (`HTTP_Gateway`, `VerifyCC`, `unit`). -/
theorem PayFA_Ta_Verify :
    PrunableOneMsg "HTTP_Gateway" "VerifyCC" "unit" PayTa := by
  apply prunable_one_msg_extC_of_step "HTTP_Gateway" _ "HTTP_Gateway" "VerifyCC" "unit"
  intro V hS
  cases hS with
  | @extCQ _ _ _ hne _ _ => exact absurd rfl hne
/-- One-message prunability of `PayTa` for (`HTTP_Gateway`, `MakeCharge`, `unit`). -/
theorem PayFA_Ta_Make :
    PrunableOneMsg "HTTP_Gateway" "MakeCharge" "unit" PayTa :=
  prunable_one_msg_extC_owner "HTTP_Gateway" _ "MakeCharge" "unit"

/-- One-message prunability of `PayS` for (`HTTP_Gateway`, `VerifyCC`, `unit`). -/
theorem PayFA_S_Verify :
    PrunableOneMsg "HTTP_Gateway" "VerifyCC" "unit" PayS := by
  apply prunable_one_msg_extC_of_step "HTTP_Gateway" _ "HTTP_Gateway" "VerifyCC" "unit"
  intro V hS
  cases hS with
