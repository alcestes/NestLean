/-- One-message prunability of `Payment` for (`HTTP_Gateway`, `VerifyCC`, `unit`). -/
theorem PayFA_T_Verify :
    PrunableOneMsg "HTTP_Gateway" "VerifyCC" "unit" Payment :=
  prunable_one_msg_trec_of_succ "HTTP_Gateway" "VerifyCC" "unit" PayFA_S_Verify
/-- One-message prunability of `Payment` for (`HTTP_Gateway`, `MakeCharge`, `unit`). -/
theorem PayFA_T_Make :
    PrunableOneMsg "HTTP_Gateway" "MakeCharge" "unit" Payment :=
  prunable_one_msg_trec_of_succ "HTTP_Gateway" "MakeCharge" "unit" PayFA_S_Make

/-- One-message prunability of `PayISub` for (`HTTP_Gateway`, `VerifyCC`, `unit`). -/
theorem PayFA_ISub_Verify :
    PrunableOneMsg "HTTP_Gateway" "VerifyCC" "unit" PayISub := by
  apply prunable_one_msg_intC_of_step _ "HTTP_Gateway" "VerifyCC" "unit"
  intro V hS
  cases hS with
  | @intC _ x hmem hHas =>
    obtain ⟨r, l, s, U⟩ := x
    simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem
    rcases hmem with ⟨rfl, rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl, rfl⟩
    · exact PayFA_Ta_Verify
    · exact PayFA_T_Verify
/-- One-message prunability of `PayISub` for (`HTTP_Gateway`, `MakeCharge`, `unit`). -/
theorem PayFA_ISub_Make :
    PrunableOneMsg "HTTP_Gateway" "MakeCharge" "unit" PayISub := by
  apply prunable_one_msg_intC_of_step _ "HTTP_Gateway" "MakeCharge" "unit"
  intro V hS
  cases hS with
  | @intC _ x hmem hHas =>
    obtain ⟨r, l, s, U⟩ := x
    simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem
    rcases hmem with ⟨rfl, rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl, rfl⟩
    · exact PayFA_Ta_Make
    · exact PayFA_T_Make

/-- One-message prunability fact. -/
theorem Pay_hfaTa : ∀ (pm : Role) (lab0 : Lab) (S0 : DataSort),
    ExposedFrom PayTa pm lab0 S0 → PrunableOneMsg pm lab0 S0 PayTa := by
  intro pm lab0 S0 hexp
  cases hexp with
  | extC_here hmem =>
    simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem
    obtain ⟨rfl, rfl, rfl⟩ := hmem
    exact PayFA_Ta_Make
  | extC_step hne hmem hsub =>
    simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem
    obtain ⟨rfl, rfl, rfl⟩ := hmem
    apply prunable_one_msg_extC_of_step "HTTP_Gateway" _ pm lab0 S0
    intro V hS
    cases hS with
    | @extCQ _ _ x _ hmem' hHas' =>
      obtain ⟨l, s, U⟩ := x
      simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem'
      obtain ⟨rfl, rfl, rfl⟩ := hmem'
      apply prunable_one_msg_intC_of_step _ pm lab0 S0
      intro W hW
      cases hW with
      | @intC _ y hmem'' hHas'' =>
        obtain ⟨r2, l2, s2, U2⟩ := y
        simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem''
        obtain ⟨rfl, rfl, rfl, rfl⟩ := hmem''
        exact prunable_one_msg_end _ _ _

/-- One-message prunability fact. -/
theorem Pay_hfaT : ∀ (pm : Role) (lab0 : Lab) (S0 : DataSort),
    ExposedFrom Payment pm lab0 S0 → PrunableOneMsg pm lab0 S0 Payment := by
  intro pm lab0 S0 hexp
  cases hexp with
  | trec hsub =>
    cases hsub with
    | extC_here hmem =>
      simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem
      obtain ⟨rfl, rfl, rfl⟩ := hmem
      exact PayFA_T_Verify
    | extC_step hne hmem hsub2 =>
      simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem
      obtain ⟨rfl, rfl, rfl⟩ := hmem
      cases hsub2 with
      | intC_step hmem2 hne2 hsub3 =>
        simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem2
        rcases hmem2 with ⟨rfl, rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl, rfl⟩
        · cases hsub3 with
          | extC_here hmem4 =>
            simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem4
            obtain ⟨rfl, rfl, rfl⟩ := hmem4
            exact PayFA_T_Make
          | extC_step hne4 hmem4 hsub5 =>
            simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem4
            obtain ⟨rfl, rfl, rfl⟩ := hmem4
            cases hsub5 with
            | intC_step hmem6 hne6 hsub7 =>
              simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem6
              obtain ⟨rfl, rfl, rfl, rfl⟩ := hmem6
              cases hsub7
        · cases hsub3

/-- One-message prunability fact. -/
theorem Pay_hfaISub : ∀ (pm : Role) (lab0 : Lab) (S0 : DataSort),
    ExposedFrom PayISub pm lab0 S0 → PrunableOneMsg pm lab0 S0 PayISub := by
  intro pm lab0 S0 _
  apply prunable_one_msg_intC_of_step _ pm lab0 S0
  intro V hS
  cases hS with
  | @intC _ x hmem hHas =>
    obtain ⟨r, l, s, U⟩ := x
    simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem
    rcases hmem with ⟨rfl, rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl, rfl⟩
    · exact Pay_hfaTa _ _ _ (has_to_exposed _ _ _ _ hHas)
    · exact Pay_hfaT _ _ _ (has_to_exposed _ _ _ _ hHas)

/-- One-message prunability fact. -/
theorem Pay_hfaS : ∀ (pm : Role) (lab0 : Lab) (S0 : DataSort),
    ExposedFrom PayS pm lab0 S0 → PrunableOneMsg pm lab0 S0 PayS := by
  intro pm lab0 S0 _
  apply prunable_one_msg_extC_of_step "HTTP_Gateway" _ pm lab0 S0
  intro V hS
  cases hS with
  | @extCQ _ _ x _ hmem hHas =>
    obtain ⟨l, s, U⟩ := x
    simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem
    obtain ⟨rfl, rfl, rfl⟩ := hmem
    exact Pay_hfaISub _ _ _ (has_to_exposed _ _ _ _ hHas)

/-- Deep adequacy of `Payment` with empty seen set. -/
theorem Payment_deep : Prunable [] Payment := by
  apply Prunable.trec_new [] "checkCC" PayB _ _ Pay_hfaT
  · simp
  · rw [PayS_subst]
    apply Prunable.extC [Payment] "HTTP_Gateway" _ _ Pay_hfaS
    intro x hmem
    simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem
    obtain rfl := hmem
    apply Prunable.intC [Payment] _ _ Pay_hfaISub
    intro y hmemY
    simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmemY
    rcases hmemY with rfl | rfl
    · apply Prunable.extC [Payment] "HTTP_Gateway" _ _ Pay_hfaTa
      intro z hmemZ
      simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmemZ
      obtain rfl := hmemZ
      show Prunable [Payment] (SessionType.internalChoice
        [("ExternalBank", "MakeCharge", "unit", SessionType.tEnd)])
      refine Prunable.intC [Payment] _ ?_ ?_
      · intro w hmemW
        simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmemW
        obtain rfl := hmemW
        exact Prunable.tEnd [Payment]
      · intro pm lab0 S0 hexp
        cases hexp with
        | intC_step hmemI hneI hsubI =>
          simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmemI
          obtain ⟨rfl, rfl, rfl, rfl⟩ := hmemI
          cases hsubI
    · exact Prunable.trec_seen [Payment] "checkCC" PayB
        (List.mem_cons.mpr (Or.inl rfl)) Pay_hfaT

/-- Internal choice: `(ExternalBank, MakeCharge, unit)` ending in `tEnd` (`Payment` mirror). -/
def PayIBank : SessionType :=
  SessionType.internalChoice
    [("ExternalBank", "MakeCharge", "unit", SessionType.tEnd)]

/-- Monitorability of `Payment` (finite prune closure). -/
theorem Payment_mon : Drainability.Monitorable Payment := by
  apply Monitorable_of_closed_set Payment
    {Payment, PayS, PayISub, PayTa, PayIBank,
     SessionType.tEnd, SessionType.tVar "checkCC"}
  · simp
  · intro U hU V hStep
    simp only [Finset.mem_insert, Finset.mem_singleton] at hU
    rcases hU with rfl | rfl | rfl | rfl | rfl | rfl | rfl
    · cases hStep with
      | trec =>
        show PayS ∈ ({Payment, PayS, PayISub, PayTa, PayIBank,
          SessionType.tEnd, SessionType.tVar "checkCC"} : Finset SessionType)
        simp
    · cases hStep with
      | extC hmem =>
        simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem
        obtain ⟨rfl, rfl, rfl⟩ := hmem
        simp
    · cases hStep with
      | intC hmem =>
        simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem
        rcases hmem with ⟨rfl, rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl, rfl⟩
        · simp
        · simp
    · cases hStep with
      | extC hmem =>
        simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem
        obtain ⟨rfl, rfl, rfl⟩ := hmem
        show PayIBank ∈ ({Payment, PayS, PayISub, PayTa, PayIBank,
          SessionType.tEnd, SessionType.tVar "checkCC"} : Finset SessionType)
        simp
    · cases hStep with
      | intC hmem =>
        simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem
        obtain ⟨rfl, rfl, rfl, rfl⟩ := hmem
        simp
    · cases hStep
    · cases hStep

-- `lst_Client` is deeply adequate and monitorable (mirror `StClient` carries the proofs).
/-- External offer by `HTTP_Gateway`: `(ValidCC, unit)` ending in `tEnd`; `(InvalidCC, unit)`
   looping on `decideOnOrder` (`Client` mirror). -/
def StConfT : SessionType :=
  SessionType.externalChoice "HTTP_Gateway"
    [("ValidCC", "unit", SessionType.tEnd),
     ("InvalidCC", "unit", SessionType.tVar "decideOnOrder")]
/-- External offer by `HTTP_Gateway`: `(Cancel, unit)` ending in `tEnd` (`Client` mirror). -/
def StCancT : SessionType :=
  SessionType.externalChoice "HTTP_Gateway" [("Cancel", "unit", SessionType.tEnd)]
/-- Internal choice: `(HTTP_Gateway, ConfirmOrder, unit)` continuing as `StConfT`;
   `(HTTP_Gateway, CancelOrder, unit)` continuing as `StCancT` (`Client` mirror). -/
def StRecB : SessionType :=
  SessionType.internalChoice
    [("HTTP_Gateway", "ConfirmOrder", "unit", StConfT),
     ("HTTP_Gateway", "CancelOrder", "unit", StCancT)]
/-- Recursive type: loop on `decideOnOrder` with body `StRecB` (`Client` mirror). -/
def StRec := SessionType.tRec "decideOnOrder" StRecB
/-- External offer by `HTTP_Gateway`: `(SKUDetails, unit)` continuing as `StRec` (`Client`
   mirror). -/
def StCB0 : SessionType :=
  SessionType.externalChoice "HTTP_Gateway" [("SKUDetails", "unit", StRec)]
/-- External offer by `HTTP_Gateway`: `(ValidCC, unit)` ending in `tEnd`; `(InvalidCC, unit)`
   continuing as `StRec` (`Client` mirror). -/
def StConfTp : SessionType :=
  SessionType.externalChoice "HTTP_Gateway"
    [("ValidCC", "unit", SessionType.tEnd),
     ("InvalidCC", "unit", StRec)]
/-- Alias of `StCancT` (`Client` mirror). -/
def StCancTp : SessionType := StCancT
/-- Internal choice: `(HTTP_Gateway, ConfirmOrder, unit)` continuing as `StConfTp`;
   `(HTTP_Gateway, CancelOrder, unit)` continuing as `StCancTp` (`Client` mirror). -/
def StRS : SessionType :=
  SessionType.internalChoice
    [("HTTP_Gateway", "ConfirmOrder", "unit", StConfTp),
     ("HTTP_Gateway", "CancelOrder", "unit", StCancTp)]
/-- Internal choice: `(HTTP_Gateway, PlaceOrder, unit)` continuing as `StCB0` (`Client` mirror). -/
def StClient : SessionType :=
  SessionType.internalChoice [("HTTP_Gateway", "PlaceOrder", "unit", StCB0)]

/-- Definitional unfolding: `StClient` is definitionally the stated type. -/
theorem StClient_eq : StClient = Client := rfl
/-- Grafting equation: substituting `(SessionType.tRec "decideOnOrder" StRecB)` for
   `decideOnOrder` in `StRecB` yields `StRS`. -/
theorem StRS_subst :
    substSessionType StRecB "decideOnOrder" (SessionType.tRec "decideOnOrder" StRecB) = StRS := rfl

/-- One-message prunability of `StRS` for (`HTTP_Gateway`, `ValidCC`, `unit`). -/
theorem StFA_RS_ValidCC :
    PrunableOneMsg "HTTP_Gateway" "ValidCC" "unit" StRS := by
  apply prunable_one_msg_intC_of_step _ "HTTP_Gateway" "ValidCC" "unit"
  intro V hS
  cases hS with
  | @intC _ x hmem hHas =>
    obtain ⟨r, l, s, U⟩ := x
    simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem
    rcases hmem with ⟨rfl, rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl, rfl⟩
    · exact prunable_one_msg_extC_owner "HTTP_Gateway" _ "ValidCC" "unit"
    · exact prunable_one_msg_extC_owner "HTTP_Gateway" _ "ValidCC" "unit"
/-- One-message prunability of `StRS` for (`HTTP_Gateway`, `InvalidCC`, `unit`). -/
theorem StFA_RS_InvalidCC :
    PrunableOneMsg "HTTP_Gateway" "InvalidCC" "unit" StRS := by
  apply prunable_one_msg_intC_of_step _ "HTTP_Gateway" "InvalidCC" "unit"
  intro V hS
  cases hS with
  | @intC _ x hmem hHas =>
