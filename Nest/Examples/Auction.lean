      obtain ⟨rfl, rfl, rfl⟩ := hmemT
      apply Prunable.intC [ARec] _ _ hfaASIA
      intro s hmemS
      simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmemS
      obtain ⟨rfl, rfl, rfl, rfl⟩ := hmemS
      exact Prunable.tEnd [ARec]
    · apply Prunable.intC [ARec] _ _ hfaALW
      intro u hmemU
      simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmemU
      obtain ⟨rfl, rfl, rfl, rfl⟩ := hmemU
      apply Prunable.extC [ARec] "BuyerB" _ _ hfaAPayB
      intro t hmemT
      simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmemT
      obtain ⟨rfl, rfl, rfl⟩ := hmemT
      apply Prunable.intC [ARec] _ _ hfaASIB
      intro s hmemS
      simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmemS
      obtain ⟨rfl, rfl, rfl, rfl⟩ := hmemS
