/-- Deep adequacy of `BuyerA` with empty seen set. -/
theorem BuyerA_deep : Prunable [] BuyerA := by
  apply Prunable.extC [] "Auction" _ _ hfaBuyerA
  intro x hmem
  simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem
  obtain ⟨rfl, rfl, rfl⟩ := hmem
  apply Prunable.trec_new [] "SendBids" BABody _ _ hfaRec
  · simp
  · have hSub : substSessionType BABody "SendBids"
        (SessionType.tRec "SendBids" BABody) = BASub := BAS_subst
    rw [hSub]
    apply Prunable.intC [BARec] _ _ hfaBASub
    intro y hmemY
    simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmemY
    obtain ⟨rfl, rfl, rfl, rfl⟩ := hmemY
    apply Prunable.intC [BARec] _ _ hfaBAConfS
    intro z hmemZ
    simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmemZ
    obtain ⟨rfl, rfl, rfl, rfl⟩ := hmemZ
    apply Prunable.extC [BARec] "Auction" _ _ hfaBAExtS
    intro w hmemW
    simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmemW
    rcases hmemW with ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩
    · exact Prunable.trec_seen [BARec] "SendBids" BABody
        (List.mem_cons.mpr (Or.inl rfl)) hfaRec
    · apply Prunable.intC [BARec] _ _ hfaBAWin
      intro v hmemV
      simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmemV
      obtain ⟨rfl, rfl, rfl, rfl⟩ := hmemV
      apply Prunable.extC [BARec] "Auction" _ _ hfaBAPay
      intro u hmemU
      simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmemU
      obtain ⟨rfl, rfl, rfl⟩ := hmemU
      exact Prunable.tEnd [BARec]
    · exact Prunable.tEnd [BARec]

/-- Definitional unfolding: `BuyerB` is definitionally the stated type. -/
theorem BuyerB_eq : BuyerB = BuyerA := rfl

/-- Monitorability of `BuyerA` (finite prune closure). -/
theorem BuyerA_mon : Drainability.Monitorable BuyerA := by
  apply Monitorable_of_closed_set BuyerA
    {BuyerA, BARec, BASub, BAConfS, BAExtS, BAWin, BAPay,
     SessionType.tEnd, SessionType.tVar "SendBids"}
  · simp
  · intro U hU V hStep
    simp only [Finset.mem_insert, Finset.mem_singleton] at hU
    rcases hU with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
    · cases hStep with
      | extC hmem =>
        simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem
        obtain ⟨rfl, rfl, rfl⟩ := hmem
        show BARec ∈ ({BuyerA, BARec, BASub, BAConfS, BAExtS, BAWin, BAPay,
          SessionType.tEnd, SessionType.tVar "SendBids"} : Finset SessionType)
        simp
    · cases hStep with
      | trec =>
        show BASub ∈ ({BuyerA, BARec, BASub, BAConfS, BAExtS, BAWin, BAPay,
          SessionType.tEnd, SessionType.tVar "SendBids"} : Finset SessionType)
        simp
    · cases hStep with
      | intC hmem =>
        simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem
        obtain ⟨rfl, rfl, rfl, rfl⟩ := hmem
        simp
    · cases hStep with
      | intC hmem =>
        simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem
        obtain ⟨rfl, rfl, rfl, rfl⟩ := hmem
        simp
    · cases hStep with
      | extC hmem =>
        simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem
        rcases hmem with ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩
        · simp
        · simp
        · simp
    · cases hStep with
      | intC hmem =>
        simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem
        obtain ⟨rfl, rfl, rfl, rfl⟩ := hmem
        simp
    · cases hStep with
      | extC hmem =>
        simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem
        obtain ⟨rfl, rfl, rfl⟩ := hmem
        simp
    · cases hStep
    · cases hStep

/-- Deep adequacy of `BuyerB` with empty seen set. -/
theorem BuyerB_deep : Prunable [] BuyerB := by
  rw [BuyerB_eq]
  exact BuyerA_deep

/-- Monitorability of `BuyerB` (finite prune closure). -/
theorem BuyerB_mon : Drainability.Monitorable BuyerB := by
  rw [BuyerB_eq]
  exact BuyerA_mon


-- Mirror defs bottom-up for `Auction` (ungrafted; Resend-loop keeps the var)
