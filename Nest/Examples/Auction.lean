  prunable_one_msg_extC_owner "Auction" _ "Init" "unit"

/-- One-message prunability fact. -/
theorem hfaRec : ∀ (pm : Role) (lab0 : Lab) (S0 : DataSort),
    ExposedFrom BARec pm lab0 S0 → PrunableOneMsg pm lab0 S0 BARec := by
  intro pm lab0 S0 hexp
  cases hexp with
  | trec hsub =>
    cases hsub with
    | intC_step hmem hne hsub2 =>
      simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem
      obtain ⟨rfl, rfl, rfl, rfl⟩ := hmem
      cases hsub2 with
      | intC_step hmem2 hne2 hsub3 =>
        simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem2
        obtain ⟨rfl, rfl, rfl, rfl⟩ := hmem2
        cases hsub3 with
        | extC_here hmem3 =>
          simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem3
          rcases hmem3 with ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩
          · exact FA_Rec_Resend
          · exact FA_Rec_Winner
          · exact FA_Rec_Loser
        | extC_step hne3 hmem3 hsub4 =>
          simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem3
          rcases hmem3 with ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩
          · cases hsub4
          · cases hsub4 with
            | intC_step hmem5 hne5 hsub6 =>
              simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem5
              obtain ⟨rfl, rfl, rfl, rfl⟩ := hmem5
              cases hsub6 with
              | extC_here hmem6 =>
                simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem6
                obtain ⟨rfl, rfl, rfl⟩ := hmem6
                exact FA_Rec_SendItem
              | extC_step hne6 hmem6 hsub7 =>
                simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem6
                obtain ⟨rfl, rfl, rfl⟩ := hmem6
                cases hsub7
          · cases hsub4

/-- One-message prunability fact. -/
theorem hfaBuyerA : ∀ (pm : Role) (lab0 : Lab) (S0 : DataSort),
    ExposedFrom BuyerA pm lab0 S0 → PrunableOneMsg pm lab0 S0 BuyerA := by
  intro pm lab0 S0 hexp
  cases hexp with
  | extC_here hmem =>
    simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem
    obtain ⟨rfl, rfl, rfl⟩ := hmem
    exact FA_A_Init
  | extC_step hne hmem hsub =>
    simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem
    obtain ⟨rfl, rfl, rfl⟩ := hmem
    apply prunable_one_msg_extC_of_step "Auction" _ pm lab0 S0
    intro V hS
    cases hS with
    | @extCQ _ _ x _ hmem' hHas =>
      obtain ⟨l, s, U⟩ := x
      simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem'
      obtain ⟨rfl, rfl, rfl⟩ := hmem'
      exact hfaRec _ _ _ (has_to_exposed _ _ _ _ hHas)

