namespace Auction

/- Session types from the NEST P4 testbed:
   `NEST/nest/nest_scala/src/main/scala/examples/06_auction.scala`
   (Scala package `auction`; file `06_auction.scala` maps to this
   module since Lean module names may not start with a digit).
   Translated below are the three `lst_*` local session types
   (`lst_Auction`, `lst_BuyerA`, `lst_BuyerB`). `lst_BuyerA` and
   `lst_BuyerB` have the same shape (same labels against `Auction`)
   and are kept as separate definitions for fidelity. Switch setup,
   IP rules, port checks and monitor wiring from `setup` are not
   session types and are not translated. Translation conventions:
   `IntChoice` branches become `internalChoice` branches
   `(agent, label, sort, cont)`; `ExtChoice` branches become
   `externalChoice` branches `(label, sort, cont)`; `Rec`/`Var`/`End`
   become `tRec`/`tVar`/`tEnd`. Agents become roles, labels stay
   labels. The Scala types carry no payload sorts, so every branch
   uses the placeholder sort `"unit"`. -/

/-- `lst_Auction`. -/
def Auction : SessionType :=
  SessionType.internalChoice
    [("BuyerA", "Init", "unit",
      SessionType.internalChoice
        [("BuyerB", "Init", "unit",
          SessionType.tRec "GetBids"
            (SessionType.externalChoice "BuyerA"
              [("Bid", "unit",
                SessionType.externalChoice "BuyerA"
                  [("Confirm", "unit",
                    SessionType.externalChoice "BuyerB"
                      [("Bid", "unit",
                        SessionType.externalChoice "BuyerB"
                          [("Confirm", "unit",
                            SessionType.internalChoice
                              [("BuyerA", "Resend", "unit",
                                SessionType.internalChoice
                                  [("BuyerB", "Resend", "unit",
                                    SessionType.tVar "GetBids")]),
                              ("BuyerA", "Winner", "unit",
                                SessionType.internalChoice
                                  [("BuyerB", "Loser", "unit",
                                    SessionType.externalChoice "BuyerA"
                                      [("Pay", "unit",
                                        SessionType.internalChoice
                                          [("BuyerA", "SendItem", "unit",
                                            SessionType.tEnd)])])]),
                              ("BuyerA", "Loser", "unit",
                                SessionType.internalChoice
                                  [("BuyerB", "Winner", "unit",
                                    SessionType.externalChoice "BuyerB"
                                      [("Pay", "unit",
                                        SessionType.internalChoice
                                          [("BuyerB", "SendItem", "unit",
                                            SessionType.tEnd)])])])])])])])]))])]

/-- `lst_BuyerA`. -/
def BuyerA : SessionType :=
  SessionType.externalChoice "Auction"
    [("Init", "unit",
      SessionType.tRec "SendBids"
        (SessionType.internalChoice
          [("Auction", "Bid", "unit",
            SessionType.internalChoice
              [("Auction", "Confirm", "unit",
                SessionType.externalChoice "Auction"
                  [("Resend", "unit", SessionType.tVar "SendBids"),
                   ("Winner", "unit",
                    SessionType.internalChoice
                      [("Auction", "Pay", "unit",
                        SessionType.externalChoice "Auction"
                          [("SendItem", "unit", SessionType.tEnd)])]),
                   ("Loser", "unit", SessionType.tEnd)])])]))]

/-- `lst_BuyerB` (same shape as `lst_BuyerA`). -/
def BuyerB : SessionType :=
  SessionType.externalChoice "Auction"
    [("Init", "unit",
      SessionType.tRec "SendBids"
        (SessionType.internalChoice
          [("Auction", "Bid", "unit",
            SessionType.internalChoice
              [("Auction", "Confirm", "unit",
                SessionType.externalChoice "Auction"
                  [("Resend", "unit", SessionType.tVar "SendBids"),
                   ("Winner", "unit",
                    SessionType.internalChoice
                      [("Auction", "Pay", "unit",
                        SessionType.externalChoice "Auction"
                          [("SendItem", "unit", SessionType.tEnd)])]),
                   ("Loser", "unit", SessionType.tEnd)])])]))]

-- Mirror defs bottom-up (ungrafted side; Resend-branch keeps the var)
/-- External offer by `Auction`: `(SendItem, unit)` ending in `tEnd` (`BuyerA` mirror). -/
def BAPay : SessionType :=
  SessionType.externalChoice "Auction" [("SendItem", "unit", SessionType.tEnd)]
/-- Internal choice: `(Auction, Pay, unit)` continuing as `BAPay` (`BuyerA` mirror). -/
def BAWin : SessionType :=
  SessionType.internalChoice [("Auction", "Pay", "unit", BAPay)]
/-- External offer by `Auction`: `(Resend, unit)` looping on `SendBids`; `(Winner, unit)`
   continuing as `BAWin`; `(Loser, unit)` ending in `tEnd` (`BuyerA` mirror). -/
def BAExt : SessionType :=
  SessionType.externalChoice "Auction"
    [("Resend", "unit", SessionType.tVar "SendBids"),
     ("Winner", "unit", BAWin),
     ("Loser", "unit", SessionType.tEnd)]
/-- Internal choice: `(Auction, Confirm, unit)` continuing as `BAExt` (`BuyerA` mirror). -/
def BAConf : SessionType :=
  SessionType.internalChoice [("Auction", "Confirm", "unit", BAExt)]
/-- Internal choice: `(Auction, Bid, unit)` continuing as `BAConf` (`BuyerA` mirror). -/
def BABody : SessionType :=
  SessionType.internalChoice [("Auction", "Bid", "unit", BAConf)]
/-- Recursive type: loop on `SendBids` with body `BABody` (`BuyerA` mirror). -/
def BARec := SessionType.tRec "SendBids" BABody
-- Grafted side (Resend-branch points at the rec)
/-- External offer by `Auction`: `(Resend, unit)` continuing as `BARec`; `(Winner, unit)`
   continuing as `BAWin`; `(Loser, unit)` ending in `tEnd` (`BuyerA` mirror). -/
def BAExtS : SessionType :=
  SessionType.externalChoice "Auction"
    [("Resend", "unit", BARec),
     ("Winner", "unit", BAWin),
     ("Loser", "unit", SessionType.tEnd)]
/-- Internal choice: `(Auction, Confirm, unit)` continuing as `BAExtS` (`BuyerA` mirror). -/
def BAConfS : SessionType :=
  SessionType.internalChoice [("Auction", "Confirm", "unit", BAExtS)]
/-- Internal choice: `(Auction, Bid, unit)` continuing as `BAConfS` (`BuyerA` mirror). -/
def BASub : SessionType :=
  SessionType.internalChoice [("Auction", "Bid", "unit", BAConfS)]

/-- Grafting equation: substituting `BARec` for `SendBids` in `BABody` yields `BASub`. -/
theorem BAS_subst :
    substSessionType BABody "SendBids" BARec = BASub := rfl

