/-- Deep adequacy of `Auction` with empty seen set. -/
theorem Auction_deep : Prunable [] Auction := by
  apply Prunable.intC [] _ _ hfaAuction
  intro x hmem
  simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem
  obtain ⟨rfl, rfl, rfl, rfl⟩ := hmem
  apply Prunable.intC [] _ _ hfaATop1
  intro y hmemY
  simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmemY
  obtain ⟨rfl, rfl, rfl, rfl⟩ := hmemY
  apply Prunable.trec_new [] "GetBids" ABody _ _ hfaARec
  · simp
  · have hSub : substSessionType ABody "GetBids"
        (SessionType.tRec "GetBids" ABody) = ASub := ASub_subst
    rw [hSub]
    apply Prunable.extC [ARec] "BuyerA" _ _ hfaASub
    intro z hmemZ
    simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmemZ
    obtain ⟨rfl, rfl, rfl⟩ := hmemZ
    apply Prunable.extC [ARec] "BuyerA" _ _ hfaAC1S
    intro w1 hmemW1
    simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmemW1
    obtain ⟨rfl, rfl, rfl⟩ := hmemW1
    apply Prunable.extC [ARec] "BuyerB" _ _ hfaAC2S
    intro w2 hmemW2
    simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmemW2
    obtain ⟨rfl, rfl, rfl⟩ := hmemW2
    apply Prunable.extC [ARec] "BuyerB" _ _ hfaAC3S
    intro w3 hmemW3
    simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmemW3
    obtain ⟨rfl, rfl, rfl⟩ := hmemW3
    apply Prunable.intC [ARec] _ _ hfaADS
    intro v hmemV
    simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmemV
    rcases hmemV with ⟨rfl, rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl, rfl⟩
    · apply Prunable.intC [ARec] _ _ hfaARS
      intro u hmemU
      simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmemU
      obtain ⟨rfl, rfl, rfl, rfl⟩ := hmemU
      exact Prunable.trec_seen [ARec] "GetBids" ABody
        (List.mem_cons.mpr (Or.inl rfl)) hfaARec
    · apply Prunable.intC [ARec] _ _ hfaAWL
      intro u hmemU
      simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmemU
      obtain ⟨rfl, rfl, rfl, rfl⟩ := hmemU
      apply Prunable.extC [ARec] "BuyerA" _ _ hfaAPayA
      intro t hmemT
