theorem Auction_eq_top : Auction = SessionType.internalChoice [("BuyerA", "Init", "unit", ATop1)] := rfl
theorem BuyerA_eq_init : BuyerA = SessionType.externalChoice "Auction" [("Init", "unit", BARec)] := rfl

theorem t0_1 : net_trans S0 (net_label.τ_comm "Auction" "BuyerA" "Init" "unit") S1 := by
  have h_send : sq_trans (Auction, [])
      (sq_action.send "BuyerA" "Init" "unit") (ATop1, []) := by
    apply sq_trans.send
    rw [Auction_eq_top]
    apply st_trans.intC
    simp only [List.mem_cons, List.mem_nil_iff, or_false]
  have h_recv : sq_trans (BuyerA, [])
      (sq_action.recv "Auction" "Init" "unit") (BuyerA, [mInitAu]) :=
    sq_trans.recv
  have hmem_p : ("Auction", (Auction, [])) ∈ S0 := by simp [S0]
  have hmem_q : ("BuyerA", (BuyerA, [])) ∈ S0 := by simp [S0]
  exact net_trans.comm (by decide) h_send h_recv hmem_p hmem_q

