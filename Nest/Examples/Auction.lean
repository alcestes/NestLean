/-- Every infinite fair path from `Net` is output-live. -/
theorem aucOL_inf : IsOutputLiveInfinitePathNetwork Net := by
  intro path h0 hfair i p Qp hmemP q lab S hdeq
  have hStar : net_trans_star Net (path.seq i) := path_star_reachable h0 i
  have hR := aucReach _ hStar
  rcases hR with h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h
  · -- S0
    rw [h] at hmemP
    obtain ⟨T, hP⟩ := hmemP
    simp only [S0, List.mem_cons, List.mem_nil_iff, or_false] at hP
    rcases hP with ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩
    · obtain ⟨Q', hQ⟩ := hdeq
      simp [Queue.dequeue, Queue.dequeue.go] at hQ
    · obtain ⟨Q', hQ⟩ := hdeq
      simp [Queue.dequeue, Queue.dequeue.go] at hQ
    · obtain ⟨Q', hQ⟩ := hdeq
      simp [Queue.dequeue, Queue.dequeue.go] at hQ
  · -- S1
    rw [h] at hmemP
    obtain ⟨T, hP⟩ := hmemP
    simp only [S1, List.mem_cons, List.mem_nil_iff, or_false] at hP
    rcases hP with ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩
    · obtain ⟨Q', hQ⟩ := hdeq
      have hmem : QueueMessage.msg q lab S ∈ [mInitAu] := Queue.dequeue_mem hQ
      simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem
      have hq : q = "Auction" := congrArg (fun m => m.1) hmem
      have hlab : lab = "Init" := congrArg (fun m => m.2) hmem
      have hS : S = "unit" := congrArg (fun m => m.3) hmem
      subst hq; subst hlab; subst hS
      have hEn : ∃ N', net_trans (path.seq (i)) (net_label.τ_dequeue "BuyerA" "Auction" "Init" "unit") N' :=
        ⟨S2, by rw [h]; exact t1_2⟩
      obtain ⟨k, hik, hEq⟩ := (hfair (i)).2 "BuyerA" "Auction" "Init" "unit" hEn
      exact ⟨k, hik, hEq⟩
    · obtain ⟨Q', hQ⟩ := hdeq
      simp [Queue.dequeue, Queue.dequeue.go] at hQ
    · obtain ⟨Q', hQ⟩ := hdeq
      simp [Queue.dequeue, Queue.dequeue.go] at hQ
  · -- S2
    rw [h] at hmemP
    obtain ⟨T, hP⟩ := hmemP
    simp only [S2, List.mem_cons, List.mem_nil_iff, or_false] at hP
    rcases hP with ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩
    · obtain ⟨Q', hQ⟩ := hdeq
      simp [Queue.dequeue, Queue.dequeue.go] at hQ
    · obtain ⟨Q', hQ⟩ := hdeq
      simp [Queue.dequeue, Queue.dequeue.go] at hQ
    · obtain ⟨Q', hQ⟩ := hdeq
      simp [Queue.dequeue, Queue.dequeue.go] at hQ
  · -- S3
    rw [h] at hmemP
    obtain ⟨T, hP⟩ := hmemP
    simp only [S3, List.mem_cons, List.mem_nil_iff, or_false] at hP
    rcases hP with ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩
    · obtain ⟨Q', hQ⟩ := hdeq
      have hmem : QueueMessage.msg q lab S ∈ [mInitAu] := Queue.dequeue_mem hQ
      simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem
