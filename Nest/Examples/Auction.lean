-- FA facts about the grafted body (concrete labels; nested of_step, no cycles)
/-- One-message prunability of `BASub` for (`Auction`, `Resend`, `unit`). -/
theorem FA_BASub_Resend : PrunableOneMsg "Auction" "Resend" "unit" BASub := by
  apply prunable_one_msg_intC_of_step _ "Auction" "Resend" "unit"
  intro V hS
  cases hS with
  | @intC _ x hmem hHas =>
    obtain ⟨r, l, s, U⟩ := x
    simp only [List.mem_cons, List.mem_nil_iff, or_false] at hmem
    obtain ⟨rfl, rfl, rfl, rfl⟩ := hmem
    rw [BA_has_ConfS_Resend_false] at hHas
    cases hHas
